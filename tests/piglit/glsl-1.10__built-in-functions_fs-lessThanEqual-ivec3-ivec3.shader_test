[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform ivec3 arg0;
uniform ivec3 arg1;

void main()
{
  bvec3 result = lessThanEqual(arg0, arg1);
  gl_FragColor = vec4(result, 0.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform ivec3 arg0 -5 -5 -5
uniform ivec3 arg1 -5 -2 -1
draw rect ortho 0 0 4 4
uniform ivec3 arg0 -5 -5 -5
uniform ivec3 arg1 0 1 2
draw rect ortho 4 0 4 4
uniform ivec3 arg0 -5 -2 -2
uniform ivec3 arg1 5 -5 -2
