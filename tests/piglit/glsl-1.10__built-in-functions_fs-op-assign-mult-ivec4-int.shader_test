[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform ivec4 arg0;
uniform int arg1;
uniform ivec4 expected;

void main()
{
  ivec4 result = arg0;
  result *= arg1;
  gl_FragColor = result == expected ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform ivec4 arg0 -64 72 88 -76
uniform int arg1 12
uniform ivec4 expected -768 864 1056 -912
draw rect ortho 0 0 4 4
uniform ivec4 arg0 -64 72 88 -76
uniform int arg1 -6
uniform ivec4 expected 384 -432 -528 456
draw rect ortho 4 0 4 4
