[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform vec4 arg0;
uniform float tolerance;
uniform vec4 expected;

void main()
{
  vec4 result = exp(arg0);
  gl_FragColor = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec4 arg0 -2.0 -0.6666667 0.6666667 2.0
uniform vec4 expected 0.13533528 0.5134171 1.9477341 7.389056
uniform float tolerance 7.659878e-05
draw rect ortho 0 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
