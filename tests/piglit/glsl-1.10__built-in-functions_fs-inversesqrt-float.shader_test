[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform float arg0;
uniform float tolerance;
uniform float expected;

void main()
{
  float result = inversesqrt(arg0);
  gl_FragColor = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform float arg0 0.1
uniform float expected 3.1622777
uniform float tolerance 3.1622778e-05
draw rect ortho 0 0 4 4
uniform float arg0 0.73333335
uniform float expected 1.1677485
uniform float tolerance 1.1677484e-05
draw rect ortho 4 0 4 4
uniform float arg0 1.3666667
uniform float expected 0.8553989
uniform float tolerance 8.55399e-06
draw rect ortho 8 0 4 4
uniform float arg0 2.0
uniform float expected 0.70710677
uniform float tolerance 7.071068e-06
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
