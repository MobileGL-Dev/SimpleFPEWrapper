[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform vec2 arg0;
uniform float tolerance;
uniform vec2 expected;

void main()
{
  gl_Position = gl_Vertex;
  vec2 result = sqrt(arg0);
  color = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec2 arg0 0.0 0.6666667
uniform vec2 expected 0.0 0.8164966
uniform float tolerance 8.164966e-06
draw rect ortho 0 0 4 4
uniform vec2 arg0 1.3333334 2.0
uniform vec2 expected 1.1547005 1.4142135
uniform float tolerance 1.8257419e-05
draw rect ortho 4 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
