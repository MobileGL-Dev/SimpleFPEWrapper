[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform ivec4 arg0;
uniform ivec4 arg1;
uniform ivec4 expected;

void main()
{
  ivec4 result = (arg0 + arg1);
  gl_FragColor = result == expected ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform ivec4 arg0 -64 72 88 -76
uniform ivec4 arg1 -64 72 88 -76
uniform ivec4 expected -128 144 176 -152
draw rect ortho 0 0 4 4
uniform ivec4 arg0 -64 72 88 -76
uniform ivec4 arg1 64 72 88 76
uniform ivec4 expected 0 144 176 0
draw rect ortho 4 0 4 4
uniform ivec4 arg0 -64 72 88 -76
uniform ivec4 arg1 -24 40 -23 64
uniform ivec4 expected -88 112 65 -12
draw rect ortho 8 0 4 4
uniform ivec4 arg0 -64 72 88 -76
uniform ivec4 arg1 24 40 23 64
uniform ivec4 expected -40 112 111 -12
draw rect ortho 12 0 4 4
uniform ivec4 arg0 64 72 88 76
uniform ivec4 arg1 -64 72 88 -76
uniform ivec4 expected 0 144 176 0
