[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform ivec4 arg0;
uniform ivec4 arg1;
uniform ivec4 expected;

void main()
{
  ivec4 result = (arg0 * arg1);
  gl_FragColor = result == expected ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform ivec4 arg0 -64 72 88 -76
uniform ivec4 arg1 -64 72 88 -76
uniform ivec4 expected 4096 5184 7744 5776
draw rect ortho 0 0 4 4
uniform ivec4 arg0 -64 72 88 -76
uniform ivec4 arg1 64 72 88 76
uniform ivec4 expected -4096 5184 7744 -5776
