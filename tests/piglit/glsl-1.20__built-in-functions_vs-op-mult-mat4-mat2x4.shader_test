[require]
GLSL >= 1.20

[vertex shader]
varying vec4 color;
uniform mat4 arg0;
uniform mat2x4 arg1;
uniform float tolerance;
uniform mat2x4 expected;

void main()
{
  gl_Position = gl_Vertex;
  mat2x4 result = (arg0 * arg1);
  mat2x4 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[0][2] * residual[0][2] + residual[0][3] * residual[0][3] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[1][2] * residual[1][2] + residual[1][3] * residual[1][3];
  color = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat4x4 arg0 -1.0 1.77 0.09 -0.91 -0.55 0.62 -0.71 -1.82 -1.08 0.48 -1.39 -1.43 1.79 -1.35 -1.21 0.72
uniform mat2x4 arg1 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform mat2x4 expected 2.1234002 -1.021 3.0252 3.7842 0.744 -1.6783999 2.8808 1.6377999
uniform float tolerance 6.585987e-05
draw rect ortho 0 0 4 4
uniform mat4x4 arg0 -1.0 1.77 0.09 -0.91 -0.55 0.62 -0.71 -1.82 -1.08 0.48 -1.39 -1.43 1.79 -1.35 -1.21 0.72
uniform mat2x4 arg1 -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
uniform mat2x4 expected 4.1762 -3.9904 2.9197 6.4027 0.84659994 -0.07070002 -1.8617 -0.29529998
uniform float tolerance 9.335846e-05
draw rect ortho 4 0 4 4
uniform mat4x4 arg0 0.06 1.6 1.25 -0.16 1.31 -0.32 0.45 0.45 1.52 0.51 1.9 -0.88 -1.96 -1.84 -0.72 0.39
uniform mat2x4 arg1 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform mat2x4 expected -3.644 -0.33859998 -3.4516 1.1378 0.86950016 -1.3957 -3.6927998 1.3224
uniform float tolerance 6.685135e-05
draw rect ortho 8 0 4 4
uniform mat4x4 arg0 0.06 1.6 1.25 -0.16 1.31 -0.32 0.45 0.45 1.52 0.51 1.9 -0.88 -1.96 -1.84 -0.72 0.39
uniform mat2x4 arg1 -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
