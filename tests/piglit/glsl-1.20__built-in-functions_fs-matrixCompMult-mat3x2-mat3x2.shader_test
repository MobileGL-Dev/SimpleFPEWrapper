[require]
GLSL >= 1.20

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform mat3x2 arg0;
uniform mat3x2 arg1;
uniform float tolerance;
uniform mat3x2 expected;

void main()
{
  mat3x2 result = matrixCompMult(arg0, arg1);
  mat3x2 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[2][0] * residual[2][0] + residual[2][1] * residual[2][1];
  gl_FragColor = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat3x2 arg0 0.09 -1.19 1.3 0.08 1.25 1.08
uniform mat3x2 arg1 0.09 -1.19 1.3 0.08 1.25 1.08
uniform mat3x2 expected 0.0081 1.4161001 1.6899998 0.0064 1.5625 1.1664001
uniform float tolerance 2.9433724e-05
draw rect ortho 0 0 4 4
uniform mat3x2 arg0 0.09 -1.19 1.3 0.08 1.25 1.08
uniform mat3x2 arg1 -0.36 -0.53 -1.08 0.88 -0.6 -1.79
uniform mat3x2 expected -0.0324 0.6307 -1.404 0.0704 -0.75 -1.9332
uniform float tolerance 2.583557e-05
draw rect ortho 4 0 4 4
uniform mat3x2 arg0 -0.36 -0.53 -1.08 0.88 -0.6 -1.79
uniform mat3x2 arg1 0.09 -1.19 1.3 0.08 1.25 1.08
uniform mat3x2 expected -0.0324 0.6307 -1.404 0.0704 -0.75 -1.9332
uniform float tolerance 2.583557e-05
draw rect ortho 8 0 4 4
uniform mat3x2 arg0 -0.36 -0.53 -1.08 0.88 -0.6 -1.79
uniform mat3x2 arg1 -0.36 -0.53 -1.08 0.88 -0.6 -1.79
uniform mat3x2 expected 0.1296 0.28089997 1.1664001 0.7744 0.36 3.2041
uniform float tolerance 3.5287027e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
