[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform float arg0;
uniform float arg1;
uniform float tolerance;
uniform float expected;

void main()
{
  float result = mod(arg0, arg1);
  gl_FragColor = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform float arg0 -1.9
uniform float arg1 -2.0
uniform float expected -1.9
uniform float tolerance 1.9e-05
draw rect ortho 0 0 4 4
uniform float arg0 -1.9
uniform float arg1 -0.6666667
uniform float expected -0.5666666
uniform float tolerance 5.666666e-06
