[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform vec3 arg0;
uniform float tolerance;
uniform vec3 expected;

void main()
{
  gl_Position = gl_Vertex;
  vec3 result = sin(arg0);
  color = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec3 arg0 -3.1415927 -1.0471976 1.0471976
uniform vec3 expected 8.742278e-08 -0.86602545 0.86602545
uniform float tolerance 0.0012288205
draw rect ortho 0 0 4 4
uniform vec3 arg0 3.1415927 -3.1415927 -1.0471976
uniform vec3 expected -8.742278e-08 8.742278e-08 -0.86602545
uniform float tolerance 0.00087749644
draw rect ortho 4 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
