[require]
GLSL >= 1.20

[vertex shader]
uniform int row;
uniform float expect;
varying vec4 color;
void main()
{
  gl_Position = gl_ModelViewProjectionMatrix * gl_Vertex;
}

[fragment shader]
uniform int row;
uniform float expect;
varying vec4 color;
void main()
{
      mat2x2[3] m = mat2x2[3](mat2x2(1.0, 2.0, 3.0, 4.0), mat2x2(5.0, 6.0, 7.0, 8.0), mat2x2(9.0, 10.0, 11.0, 12.0));
    gl_FragColor = (m[1][1][row] == expect)       ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}


[test]
clear color 0.5 0.5 0.5 0.5
clear
ortho




uniform int row 0
uniform float expect 7
draw rect 60 5 10 10
probe rgb 65 10 0.0 1.0 0.0

uniform int row 1
uniform float expect 8
draw rect 60 20 10 10
probe rgb 65 25 0.0 1.0 0.0

