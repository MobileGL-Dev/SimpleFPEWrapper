[require]
GLSL >= 1.20

[vertex shader]
varying vec4 color;
uniform mat2x4 arg0;
uniform float arg1;
uniform float tolerance;
uniform mat2x4 expected;

void main()
{
  gl_Position = gl_Vertex;
  mat2x4 result = (arg0 + arg1);
  mat2x4 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[0][2] * residual[0][2] + residual[0][3] * residual[0][3] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[1][2] * residual[1][2] + residual[1][3] * residual[1][3];
  color = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat2x4 arg0 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform float arg1 0.0
uniform mat2x4 expected 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform float tolerance 3.2259573e-05
draw rect ortho 0 0 4 4
uniform mat2x4 arg0 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform float arg1 -1.33
uniform mat2x4 expected -1.1700001 -2.13 -3.0700002 -1.35 -3.02 -0.74000007 -2.76 -2.54
uniform float tolerance 6.3945605e-05
draw rect ortho 4 0 4 4
uniform mat2x4 arg0 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform float arg1 0.85
uniform mat2x4 expected 1.01 0.050000012 -0.89 0.83000004 -0.84000003 1.44 -0.5799999 -0.36
uniform float tolerance 2.3976656e-05
draw rect ortho 8 0 4 4
uniform mat2x4 arg0 -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
uniform float arg1 0.0
uniform mat2x4 expected -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
uniform float tolerance 2.900069e-05
draw rect ortho 12 0 4 4
uniform mat2x4 arg0 -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
uniform float arg1 -1.33
uniform mat2x4 expected -2.35 -2.97 -2.92 -1.03 -0.59000003 -1.46 -0.86 -0.20000005
