[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform int arg0;
uniform int arg1;

void main()
{
  gl_Position = gl_Vertex;
  bool result = (arg0 != arg1);
  color = vec4(result, 0.0, 0.0, 0.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

