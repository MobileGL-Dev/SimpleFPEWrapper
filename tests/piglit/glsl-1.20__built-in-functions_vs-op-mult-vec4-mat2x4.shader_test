[require]
GLSL >= 1.20

[vertex shader]
varying vec4 color;
uniform vec4 arg0;
uniform mat2x4 arg1;
uniform float tolerance;
uniform vec2 expected;

void main()
{
  gl_Position = gl_Vertex;
  vec2 result = (arg0 * arg1);
  color = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec4 arg0 -1.65 1.33 1.93 0.76
uniform mat2x4 arg1 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform vec2 expected -4.7014 -0.106299795
uniform float tolerance 4.7026017e-05
draw rect ortho 0 0 4 4
uniform vec4 arg0 -1.65 1.33 1.93 0.76
uniform mat2x4 arg1 -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
uniform vec2 expected -3.3389 0.37199995
uniform float tolerance 3.3595592e-05
draw rect ortho 4 0 4 4
uniform vec4 arg0 0.8 -0.15 -0.51 0.0
uniform mat2x4 arg1 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform vec2 expected 1.1353999 -0.7112001
uniform float tolerance 1.3397533e-05
draw rect ortho 8 0 4 4
uniform vec4 arg0 0.8 -0.15 -0.51 0.0
uniform mat2x4 arg1 -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
uniform vec2 expected 0.24090001 0.37180004
uniform float tolerance 4.430215e-06
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
