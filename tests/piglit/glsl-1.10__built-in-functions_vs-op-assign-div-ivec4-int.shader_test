[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform ivec4 arg0;
uniform int arg1;
uniform ivec4 expected;

void main()
{
  gl_Position = gl_Vertex;
  ivec4 result = arg0;
  result /= arg1;
  color = result == expected ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform ivec4 arg0 -64 72 88 -76
uniform int arg1 12
uniform ivec4 expected -5 6 7 -6
draw rect ortho 0 0 4 4
uniform ivec4 arg0 -64 72 88 -76
uniform int arg1 -6
uniform ivec4 expected 10 -12 -14 12
draw rect ortho 4 0 4 4
uniform ivec4 arg0 -64 72 88 -76
uniform int arg1 76
uniform ivec4 expected 0 0 1 -1
draw rect ortho 8 0 4 4
uniform ivec4 arg0 -64 72 88 -76
uniform int arg1 -32
uniform ivec4 expected 2 -2 -2 2
