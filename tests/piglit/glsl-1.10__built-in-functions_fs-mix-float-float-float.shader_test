[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform float arg0;
uniform float arg1;
uniform float arg2;
uniform float tolerance;
uniform float expected;

void main()
{
  float result = mix(arg0, arg1, arg2);
  gl_FragColor = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform float arg0 -2.0
uniform float arg1 -3.0
uniform float arg2 0.0
uniform float expected -2.0
uniform float tolerance 2e-05
draw rect ortho 0 0 4 4
uniform float arg0 -2.0
uniform float arg1 -3.0
uniform float arg2 0.33333334
uniform float expected -2.3333333
uniform float tolerance 2.3333334e-05
draw rect ortho 4 0 4 4
uniform float arg0 -2.0
uniform float arg1 -3.0
uniform float arg2 0.6666667
