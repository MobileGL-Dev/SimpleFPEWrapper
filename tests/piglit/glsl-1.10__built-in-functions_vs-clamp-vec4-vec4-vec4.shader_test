[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform vec4 arg0;
uniform vec4 arg1;
uniform vec4 arg2;
uniform float tolerance;
uniform vec4 expected;

void main()
{
  gl_Position = gl_Vertex;
  vec4 result = clamp(arg0, arg1, arg2);
  color = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec4 arg0 -2.0 -2.0 -2.0 -2.0
uniform vec4 arg1 -1.5 -1.5 -1.5 0.0
uniform vec4 arg2 -1.5 0.0 1.5 0.0
uniform vec4 expected -1.5 -1.5 -1.5 0.0
uniform float tolerance 2.598076e-05
draw rect ortho 0 0 4 4
uniform vec4 arg0 -2.0 -2.0 -0.6666667 -0.6666667
uniform vec4 arg1 0.0 1.5 -1.5 -1.5
uniform vec4 arg2 1.5 1.5 -1.5 0.0
uniform vec4 expected 0.0 1.5 -1.5 -0.6666667
uniform float tolerance 2.2236107e-05
draw rect ortho 4 0 4 4
uniform vec4 arg0 -0.6666667 -0.6666667 -0.6666667 -0.6666667
uniform vec4 arg1 -1.5 0.0 0.0 1.5
uniform vec4 arg2 1.5 0.0 1.5 1.5
uniform vec4 expected -0.6666667 0.0 0.0 1.5
uniform float tolerance 1.6414762e-05
draw rect ortho 8 0 4 4
uniform vec4 arg0 0.6666667 0.6666667 0.6666667 0.6666667
uniform vec4 arg1 -1.5 -1.5 -1.5 0.0
uniform vec4 arg2 -1.5 0.0 1.5 0.0
uniform vec4 expected -1.5 0.0 0.6666667 0.0
uniform float tolerance 1.6414762e-05
draw rect ortho 12 0 4 4
uniform vec4 arg0 0.6666667 0.6666667 2.0 2.0
uniform vec4 arg1 0.0 1.5 -1.5 -1.5
uniform vec4 arg2 1.5 1.5 -1.5 0.0
uniform vec4 expected 0.6666667 1.5 -1.5 0.0
uniform float tolerance 2.2236107e-05
draw rect ortho 16 0 4 4
uniform vec4 arg0 2.0 2.0 2.0 2.0
uniform vec4 arg1 -1.5 0.0 0.0 1.5
uniform vec4 arg2 1.5 0.0 1.5 1.5
uniform vec4 expected 1.5 0.0 1.5 1.5
uniform float tolerance 2.598076e-05
draw rect ortho 20 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (16, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (20, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
