[require]
GLSL >= 1.20

[vertex shader]
varying vec4 color;
uniform mat3x2 arg0;
uniform float arg1;
uniform float tolerance;
uniform mat3x2 expected;

void main()
{
  gl_Position = gl_Vertex;
  mat3x2 result = arg0;
  result -= arg1;
  mat3x2 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[2][0] * residual[2][0] + residual[2][1] * residual[2][1];
  color = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat3x2 arg0 0.09 -1.19 1.3 0.08 1.25 1.08
uniform float arg1 0.0
uniform mat3x2 expected 0.09 -1.19 1.3 0.08 1.25 1.08
uniform float tolerance 2.418574e-05
draw rect ortho 0 0 4 4
uniform mat3x2 arg0 0.09 -1.19 1.3 0.08 1.25 1.08
uniform float arg1 -1.33
uniform mat3x2 expected 1.4200001 0.13999999 2.63 1.4100001 2.58 2.41
uniform float tolerance 4.8379232e-05
