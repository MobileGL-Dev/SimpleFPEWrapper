[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform ivec2 arg0;
uniform int arg1;
uniform ivec2 expected;

void main()
{
  ivec2 result = (arg0 / arg1);
  gl_FragColor = result == expected ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform ivec2 arg0 38 35
uniform int arg1 12
uniform ivec2 expected 3 2
draw rect ortho 0 0 4 4
uniform ivec2 arg0 38 35
uniform int arg1 -6
uniform ivec2 expected -6 -5
draw rect ortho 4 0 4 4
uniform ivec2 arg0 38 35
uniform int arg1 76
uniform ivec2 expected 0 0
draw rect ortho 8 0 4 4
uniform ivec2 arg0 38 35
uniform int arg1 -32
uniform ivec2 expected -1 -1
draw rect ortho 12 0 4 4
uniform ivec2 arg0 64 -9
uniform int arg1 12
uniform ivec2 expected 5 0
draw rect ortho 16 0 4 4
uniform ivec2 arg0 64 -9
uniform int arg1 -6
uniform ivec2 expected -10 1
draw rect ortho 20 0 4 4
uniform ivec2 arg0 64 -9
uniform int arg1 76
uniform ivec2 expected 0 0
draw rect ortho 24 0 4 4
uniform ivec2 arg0 64 -9
uniform int arg1 -32
uniform ivec2 expected -2 0
draw rect ortho 28 0 4 4
uniform ivec2 arg0 64 9
uniform int arg1 12
uniform ivec2 expected 5 0
draw rect ortho 32 0 4 4
uniform ivec2 arg0 64 9
uniform int arg1 -6
uniform ivec2 expected -10 -1
draw rect ortho 36 0 4 4
uniform ivec2 arg0 64 9
uniform int arg1 76
uniform ivec2 expected 0 0
draw rect ortho 40 0 4 4
uniform ivec2 arg0 64 9
uniform int arg1 -32
uniform ivec2 expected -2 0
draw rect ortho 44 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
