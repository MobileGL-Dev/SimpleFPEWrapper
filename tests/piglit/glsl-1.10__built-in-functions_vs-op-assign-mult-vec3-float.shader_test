[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform vec3 arg0;
uniform float arg1;
uniform float tolerance;
uniform vec3 expected;

void main()
{
  gl_Position = gl_Vertex;
  vec3 result = arg0;
  result *= arg1;
  color = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec3 arg0 -0.03 -0.85 -0.94
uniform float arg1 0.0
uniform vec3 expected 0.0 0.0 0.0
uniform float tolerance 0.0
draw rect ortho 0 0 4 4
uniform vec3 arg0 -0.03 -0.85 -0.94
uniform float arg1 -1.33
uniform vec3 expected 0.0399 1.1305001 1.2502
uniform float tolerance 1.6860078e-05
draw rect ortho 4 0 4 4
uniform vec3 arg0 -0.03 -0.85 -0.94
uniform float arg1 0.85
uniform vec3 expected -0.0255 -0.7225 -0.799
uniform float tolerance 1.07752385e-05
draw rect ortho 8 0 4 4
uniform vec3 arg0 1.67 0.66 1.87
uniform float arg1 0.0
uniform vec3 expected 0.0 0.0 0.0
uniform float tolerance 0.0
draw rect ortho 12 0 4 4
uniform vec3 arg0 1.67 0.66 1.87
uniform float arg1 -1.33
uniform vec3 expected -2.2211 -0.87780005 -2.4871001
uniform float tolerance 3.4481134e-05
draw rect ortho 16 0 4 4
uniform vec3 arg0 1.67 0.66 1.87
uniform float arg1 0.85
uniform vec3 expected 1.4195 0.56100005 1.5895001
uniform float tolerance 2.2036815e-05
draw rect ortho 20 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (16, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (20, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
