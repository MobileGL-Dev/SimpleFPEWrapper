[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform vec2 arg0;
uniform vec2 arg1;
uniform float arg2;
uniform float tolerance;
uniform vec2 expected;

void main()
{
  vec2 result = mix(arg0, arg1, arg2);
  gl_FragColor = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec2 arg0 -2.0 -2.0
uniform vec2 arg1 -3.0 3.0
uniform float arg2 0.0
uniform vec2 expected -2.0 -2.0
uniform float tolerance 2.828427e-05
draw rect ortho 0 0 4 4
uniform vec2 arg0 2.0 2.0
uniform vec2 arg1 -3.0 3.0
uniform float arg2 0.0
uniform vec2 expected 2.0 2.0
uniform float tolerance 2.828427e-05
draw rect ortho 4 0 4 4
uniform vec2 arg0 -2.0 -2.0
uniform vec2 arg1 -3.0 3.0
uniform float arg2 0.33333334
uniform vec2 expected -2.3333333 -0.33333328
uniform float tolerance 2.3570226e-05
draw rect ortho 8 0 4 4
uniform vec2 arg0 2.0 2.0
uniform vec2 arg1 -3.0 3.0
uniform float arg2 0.33333334
uniform vec2 expected 0.33333328 2.3333333
uniform float tolerance 2.3570226e-05
draw rect ortho 12 0 4 4
uniform vec2 arg0 -2.0 -2.0
uniform vec2 arg1 -3.0 3.0
uniform float arg2 0.6666667
uniform vec2 expected -2.6666667 1.3333335
uniform float tolerance 2.981424e-05
draw rect ortho 16 0 4 4
uniform vec2 arg0 2.0 2.0
uniform vec2 arg1 -3.0 3.0
uniform float arg2 0.6666667
uniform vec2 expected -1.3333335 2.6666667
uniform float tolerance 2.981424e-05
draw rect ortho 20 0 4 4
uniform vec2 arg0 -2.0 -2.0
uniform vec2 arg1 -3.0 3.0
uniform float arg2 1.0
uniform vec2 expected -3.0 3.0
uniform float tolerance 4.2426407e-05
draw rect ortho 24 0 4 4
uniform vec2 arg0 2.0 2.0
uniform vec2 arg1 -3.0 3.0
uniform float arg2 1.0
uniform vec2 expected -3.0 3.0
uniform float tolerance 4.2426407e-05
draw rect ortho 28 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (16, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (20, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (24, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (28, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
