[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform mat3 arg0;
uniform mat3 arg1;
uniform float tolerance;
uniform mat3 expected;

void main()
{
  mat3 result = (arg0 * arg1);
  mat3 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[0][2] * residual[0][2] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[1][2] * residual[1][2] + residual[2][0] * residual[2][0] + residual[2][1] * residual[2][1] + residual[2][2] * residual[2][2];
  gl_FragColor = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat3x3 arg0 -1.11 0.13 0.56 1.67 1.09 0.95 -0.41 -0.02 0.24
uniform mat3x3 arg1 -1.11 0.13 0.56 1.67 1.09 0.95 -0.41 -0.02 0.24
uniform mat3x3 expected 1.2196 -0.013799997 -0.36370003 -0.42289996 1.3862001 2.1987 0.3233 -0.0799 -0.191
uniform float tolerance 2.9499079e-05
draw rect ortho 0 0 4 4
uniform mat3x3 arg0 -1.11 0.13 0.56 1.67 1.09 0.95 -0.41 -0.02 0.24
uniform mat3x3 arg1 -1.69 -1.09 -1.53 -0.46 1.75 -0.7 -0.18 2.0 -1.47
uniform mat3x3 expected 0.6829001 -1.3772001 -2.3491 3.7201 1.8617 1.2369 4.1425 2.186 1.4463999
uniform float tolerance 7.123712e-05
draw rect ortho 4 0 4 4
uniform mat3x3 arg0 -1.69 -1.09 -1.53 -0.46 1.75 -0.7 -0.18 2.0 -1.47
uniform mat3x3 arg1 -1.11 0.13 0.56 1.67 1.09 0.95 -0.41 -0.02 0.24
uniform mat3x3 expected 1.7153001 2.5574 0.7841 -3.4947 1.9872 -4.7146 0.6589 0.8919 0.28849998
uniform float tolerance 7.0568814e-05
draw rect ortho 8 0 4 4
uniform mat3x3 arg0 -1.69 -1.09 -1.53 -0.46 1.75 -0.7 -0.18 2.0 -1.47
uniform mat3x3 arg1 -1.69 -1.09 -1.53 -0.46 1.75 -0.7 -0.18 2.0 -1.47
uniform mat3x3 expected 3.6329002 -3.1253998 5.5978003 0.09840003 2.1639001 0.50780004 -0.35119998 0.75619996 1.0363001
uniform float tolerance 7.8115656e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
