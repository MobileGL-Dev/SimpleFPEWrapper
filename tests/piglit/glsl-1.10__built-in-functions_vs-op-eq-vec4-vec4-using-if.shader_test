[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform vec4 arg0;
uniform vec4 arg1;

void main()
{
  gl_Position = gl_Vertex;
  if((arg0 == arg1))
    color = vec4(1.0, 1.0, 0.0, 1.0);
  else
    color = vec4(0.0, 0.0, 1.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec4 arg0 -1.65 1.33 1.93 0.76
uniform vec4 arg1 -1.65 1.33 1.93 0.76
draw rect ortho 0 0 4 4
uniform vec4 arg0 -1.65 1.33 1.93 0.76
uniform vec4 arg1 0.8 -0.15 -0.51 0.0
draw rect ortho 4 0 4 4
uniform vec4 arg0 0.8 -0.15 -0.51 0.0
uniform vec4 arg1 -1.65 1.33 1.93 0.76
draw rect ortho 8 0 4 4
uniform vec4 arg0 0.8 -0.15 -0.51 0.0
uniform vec4 arg1 0.8 -0.15 -0.51 0.0
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (1.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 0.0, 1.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 0.0, 1.0, 1.0)
probe rect rgba (12, 0, 4, 4) (1.0, 1.0, 0.0, 1.0)
