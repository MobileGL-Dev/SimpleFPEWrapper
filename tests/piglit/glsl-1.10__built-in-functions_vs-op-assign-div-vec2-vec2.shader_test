[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform vec2 arg0;
uniform vec2 arg1;
uniform float tolerance;
uniform vec2 expected;

void main()
{
  gl_Position = gl_Vertex;
  vec2 result = arg0;
  result /= arg1;
  color = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec2 arg0 -0.1 -1.2
uniform vec2 arg1 -0.1 -1.2
uniform vec2 expected 1.0 1.0
uniform float tolerance 1.4142136e-05
draw rect ortho 0 0 4 4
uniform vec2 arg0 -0.1 -1.2
uniform vec2 arg1 -0.42 0.48
uniform vec2 expected 0.23809525 -2.5000002
uniform float tolerance 2.5113124e-05
draw rect ortho 4 0 4 4
uniform vec2 arg0 -0.42 0.48
uniform vec2 arg1 -0.1 -1.2
uniform vec2 expected 4.2 -0.39999998
uniform float tolerance 4.2190044e-05
draw rect ortho 8 0 4 4
uniform vec2 arg0 -0.42 0.48
uniform vec2 arg1 -0.42 0.48
uniform vec2 expected 1.0 1.0
uniform float tolerance 1.4142136e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
