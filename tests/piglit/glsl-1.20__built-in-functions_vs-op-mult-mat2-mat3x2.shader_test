[require]
GLSL >= 1.20

[vertex shader]
varying vec4 color;
uniform mat2 arg0;
uniform mat3x2 arg1;
uniform float tolerance;
uniform mat3x2 expected;

void main()
{
  gl_Position = gl_Vertex;
  mat3x2 result = (arg0 * arg1);
  mat3x2 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[2][0] * residual[2][0] + residual[2][1] * residual[2][1];
  color = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat2x2 arg0 1.6 1.53 0.76 -1.0
uniform mat3x2 arg1 0.09 -1.19 1.3 0.08 1.25 1.08
uniform mat3x2 expected -0.7604 1.3277 2.1408 1.9089999 2.8208 0.8324999
uniform float tolerance 4.383865e-05
draw rect ortho 0 0 4 4
uniform mat2x2 arg0 1.6 1.53 0.76 -1.0
uniform mat3x2 arg1 -0.36 -0.53 -1.08 0.88 -0.6 -1.79
uniform mat3x2 expected -0.9788 -0.020800041 -1.0592 -2.5324001 -2.3204 0.8719999
uniform float tolerance 3.825974e-05
draw rect ortho 4 0 4 4
uniform mat2x2 arg0 -0.13 -1.4 -0.87 1.4
uniform mat3x2 arg1 0.09 -1.19 1.3 0.08 1.25 1.08
uniform mat3x2 expected 1.0236001 -1.792 -0.23859999 -1.708 -1.1021 -0.23799993
uniform float tolerance 2.9162447e-05
draw rect ortho 8 0 4 4
uniform mat2x2 arg0 -0.13 -1.4 -0.87 1.4
uniform mat3x2 arg1 -0.36 -0.53 -1.08 0.88 -0.6 -1.79
uniform mat3x2 expected 0.5079 -0.23799993 -0.6252 2.744 1.6352999 -1.6659999
uniform float tolerance 3.6992944e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
