[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform bool arg0;
uniform bvec3 arg1;
uniform bvec3 arg2;

void main()
{
  gl_Position = gl_Vertex;
  bvec3 result = (arg0 ? arg1 : arg2);
  color = vec4(result, 0.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

