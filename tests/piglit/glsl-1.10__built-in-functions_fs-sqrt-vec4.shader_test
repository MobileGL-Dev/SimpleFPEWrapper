[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform vec4 arg0;
uniform float tolerance;
uniform vec4 expected;

void main()
{
  vec4 result = sqrt(arg0);
  gl_FragColor = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec4 arg0 0.0 0.6666667 1.3333334 2.0
uniform vec4 expected 0.0 0.8164966 1.1547005 1.4142135
uniform float tolerance 2.0000001e-05
draw rect ortho 0 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
