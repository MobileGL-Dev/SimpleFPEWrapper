[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform vec3 arg0;
uniform vec3 arg1;
uniform float tolerance;
uniform vec3 expected;

void main()
{
  vec3 result = pow(arg0, arg1);
  gl_FragColor = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec3 arg0 0.0 0.0 0.6666667
uniform vec3 arg1 0.6666667 2.0 -2.0
uniform vec3 expected 0.0 0.0 2.2499998
uniform float tolerance 2.2499999e-05
draw rect ortho 0 0 4 4
uniform vec3 arg0 0.6666667 0.6666667 0.6666667
uniform vec3 arg1 -0.6666667 0.6666667 2.0
uniform vec3 expected 1.3103707 0.7631428 0.44444448
uniform float tolerance 1.5801865e-05
draw rect ortho 4 0 4 4
uniform vec3 arg0 1.3333334 1.3333334 1.3333334
uniform vec3 arg1 -2.0 -0.6666667 0.6666667
uniform vec3 expected 0.56249994 0.8254818 1.2114137
uniform float tolerance 1.5701431e-05
draw rect ortho 8 0 4 4
uniform vec3 arg0 1.3333334 2.0 2.0
uniform vec3 arg1 2.0 -2.0 -0.6666667
uniform vec3 expected 1.7777779 0.25 0.62996054
uniform float tolerance 1.9025889e-05
draw rect ortho 12 0 4 4
uniform vec3 arg0 2.0 2.0 0.0
uniform vec3 arg1 0.6666667 2.0 0.6666667
uniform vec3 expected 1.587401 4.0 0.0
uniform float tolerance 4.3034684e-05
draw rect ortho 16 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (16, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
