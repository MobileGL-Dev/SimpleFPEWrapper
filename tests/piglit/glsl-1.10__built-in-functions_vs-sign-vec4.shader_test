[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform vec4 arg0;
uniform float tolerance;
uniform vec4 expected;

void main()
{
  gl_Position = gl_Vertex;
  vec4 result = sign(arg0);
  color = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec4 arg0 -1.5 -0.75 0.0 0.75
uniform vec4 expected -1.0 -1.0 0.0 1.0
uniform float tolerance 1.7320508e-05
draw rect ortho 0 0 4 4
uniform vec4 arg0 1.5 -1.5 -0.75 0.0
uniform vec4 expected 1.0 -1.0 -1.0 0.0
uniform float tolerance 1.7320508e-05
draw rect ortho 4 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
