[require]
GLSL >= 1.20

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform mat2x4 arg0;
uniform mat2x4 arg1;

void main()
{
  bool result = (arg0 != arg1);
  gl_FragColor = vec4(result, 0.0, 0.0, 0.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat2x4 arg0 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform mat2x4 arg1 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
draw rect ortho 0 0 4 4
uniform mat2x4 arg0 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform mat2x4 arg1 -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
draw rect ortho 4 0 4 4
uniform mat2x4 arg0 -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
uniform mat2x4 arg1 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
draw rect ortho 8 0 4 4
uniform mat2x4 arg0 -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
uniform mat2x4 arg1 -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 0.0, 0.0, 0.0)
probe rect rgba (4, 0, 4, 4) (1.0, 0.0, 0.0, 0.0)
probe rect rgba (8, 0, 4, 4) (1.0, 0.0, 0.0, 0.0)
probe rect rgba (12, 0, 4, 4) (0.0, 0.0, 0.0, 0.0)
