[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform vec3 arg0;
uniform vec3 arg1;
uniform float tolerance;
uniform vec3 expected;

void main()
{
  gl_Position = gl_Vertex;
  vec3 result = mod(arg0, arg1);
  color = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec3 arg0 -1.9 -1.9 -1.9
uniform vec3 arg1 -2.0 -0.6666667 0.6666667
uniform vec3 expected -1.9 -0.5666666 0.10000008
uniform float tolerance 1.985223e-05
draw rect ortho 0 0 4 4
uniform vec3 arg0 -1.9 -0.6333333 -0.6333333
uniform vec3 arg1 2.0 -2.0 -0.6666667
uniform vec3 expected 0.100000024 -0.6333333 -0.6333333
uniform float tolerance 9.012337e-06
draw rect ortho 4 0 4 4
uniform vec3 arg0 -0.6333333 -0.6333333 0.6333333
uniform vec3 arg1 0.6666667 2.0 -2.0
uniform vec3 expected 0.03333336 1.3666667 -1.3666667
uniform float tolerance 1.9330459e-05
draw rect ortho 8 0 4 4
uniform vec3 arg0 0.6333333 0.6333333 0.6333333
uniform vec3 arg1 -0.6666667 0.6666667 2.0
uniform vec3 expected -0.03333336 0.6333333 0.6333333
uniform float tolerance 8.962887e-06
draw rect ortho 12 0 4 4
uniform vec3 arg0 1.9 1.9 1.9
uniform vec3 arg1 -2.0 -0.6666667 0.6666667
uniform vec3 expected -0.100000024 -0.10000008 0.5666666
uniform float tolerance 5.840471e-06
draw rect ortho 16 0 4 4
uniform vec3 arg0 1.9 -1.9 -1.9
uniform vec3 arg1 2.0 -2.0 -0.6666667
uniform vec3 expected 1.9 -1.9 -0.5666666
uniform float tolerance 2.7461083e-05
draw rect ortho 20 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (16, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (20, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
