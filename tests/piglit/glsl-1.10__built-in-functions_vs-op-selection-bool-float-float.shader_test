[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform bool arg0;
uniform float arg1;
uniform float arg2;
uniform float tolerance;
uniform float expected;

void main()
{
  gl_Position = gl_Vertex;
  float result = (arg0 ? arg1 : arg2);
  color = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform int arg0 0
uniform float arg1 0.0
uniform float arg2 0.0
uniform float expected 0.0
uniform float tolerance 0.0
