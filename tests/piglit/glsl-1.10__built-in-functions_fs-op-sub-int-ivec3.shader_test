[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform int arg0;
uniform ivec3 arg1;
uniform ivec3 expected;

void main()
{
  ivec3 result = (arg0 - arg1);
  gl_FragColor = result == expected ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform int arg0 12
uniform ivec3 arg1 -36 32 -88
uniform ivec3 expected 48 -20 100
draw rect ortho 0 0 4 4
uniform int arg0 12
uniform ivec3 arg1 36 32 88
uniform ivec3 expected -24 -20 -76
draw rect ortho 4 0 4 4
uniform int arg0 12
uniform ivec3 arg1 59 77 68
uniform ivec3 expected -47 -65 -56
draw rect ortho 8 0 4 4
uniform int arg0 -6
uniform ivec3 arg1 -36 32 -88
uniform ivec3 expected 30 -38 82
draw rect ortho 12 0 4 4
