[require]
GLSL >= 1.20

[vertex shader]
varying vec4 color;
uniform vec4 arg0;
uniform vec3 arg1;
uniform float tolerance;
uniform mat3x4 expected;

void main()
{
  gl_Position = gl_Vertex;
  mat3x4 result = outerProduct(arg0, arg1);
  mat3x4 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[0][2] * residual[0][2] + residual[0][3] * residual[0][3] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[1][2] * residual[1][2] + residual[1][3] * residual[1][3] + residual[2][0] * residual[2][0] + residual[2][1] * residual[2][1] + residual[2][2] * residual[2][2] + residual[2][3] * residual[2][3];
  color = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec4 arg0 -1.65 1.33 1.93 0.76
uniform vec3 arg1 -0.03 -0.85 -0.94
uniform mat3x4 expected 0.0495 -0.0399 -0.057899997 -0.022799999 1.4025 -1.1305001 -1.6405 -0.646 1.551 -1.2502 -1.8141999 -0.7144
uniform float tolerance 3.7592283e-05
draw rect ortho 0 0 4 4
uniform vec4 arg0 -1.65 1.33 1.93 0.76
uniform vec3 arg1 1.67 0.66 1.87
uniform mat3x4 expected -2.7554998 2.2211 3.2231 1.2692 -1.089 0.87780005 1.2738 0.5016 -3.0855 2.4871001 3.6090999 1.4212
uniform float tolerance 7.688128e-05
draw rect ortho 4 0 4 4
uniform vec4 arg0 0.8 -0.15 -0.51 0.0
uniform vec3 arg1 -0.03 -0.85 -0.94
uniform mat3x4 expected -0.024 0.0045000003 0.015299999 -0.0 -0.68 0.12750001 0.4335 -0.0 -0.75200003 0.141 0.47939998 -0.0
uniform float tolerance 1.2176281e-05
draw rect ortho 8 0 4 4
uniform vec4 arg0 0.8 -0.15 -0.51 0.0
uniform vec3 arg1 1.67 0.66 1.87
uniform mat3x4 expected 1.336 -0.2505 -0.85169995 0.0 0.52800006 -0.09900001 -0.3366 0.0 1.496 -0.28050002 -0.9537 0.0
uniform float tolerance 2.4902136e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
