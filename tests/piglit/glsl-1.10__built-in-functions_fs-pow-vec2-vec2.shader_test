[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform vec2 arg0;
uniform vec2 arg1;
uniform float tolerance;
uniform vec2 expected;

void main()
{
  vec2 result = pow(arg0, arg1);
  gl_FragColor = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec2 arg0 0.0 0.0
uniform vec2 arg1 0.6666667 2.0
uniform vec2 expected 0.0 0.0
uniform float tolerance 0.0
draw rect ortho 0 0 4 4
uniform vec2 arg0 0.6666667 0.6666667
uniform vec2 arg1 -2.0 -0.6666667
uniform vec2 expected 2.2499998 1.3103707
uniform float tolerance 2.603761e-05
draw rect ortho 4 0 4 4
uniform vec2 arg0 0.6666667 0.6666667
uniform vec2 arg1 0.6666667 2.0
uniform vec2 expected 0.7631428 0.44444448
uniform float tolerance 8.831295e-06
draw rect ortho 8 0 4 4
uniform vec2 arg0 1.3333334 1.3333334
uniform vec2 arg1 -2.0 -0.6666667
uniform vec2 expected 0.56249994 0.8254818
uniform float tolerance 9.989126e-06
draw rect ortho 12 0 4 4
uniform vec2 arg0 1.3333334 1.3333334
uniform vec2 arg1 0.6666667 2.0
uniform vec2 expected 1.2114137 1.7777779
uniform float tolerance 2.1512828e-05
draw rect ortho 16 0 4 4
uniform vec2 arg0 2.0 2.0
uniform vec2 arg1 -2.0 -0.6666667
uniform vec2 expected 0.25 0.62996054
uniform float tolerance 6.777538e-06
draw rect ortho 20 0 4 4
uniform vec2 arg0 2.0 2.0
uniform vec2 arg1 0.6666667 2.0
uniform vec2 expected 1.587401 4.0
uniform float tolerance 4.3034684e-05
draw rect ortho 24 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (16, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (20, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (24, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
