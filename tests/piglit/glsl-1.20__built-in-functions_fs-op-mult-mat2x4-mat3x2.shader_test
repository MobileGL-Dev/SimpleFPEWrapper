[require]
GLSL >= 1.20

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform mat2x4 arg0;
uniform mat3x2 arg1;
uniform float tolerance;
uniform mat3x4 expected;

void main()
{
  mat3x4 result = (arg0 * arg1);
  mat3x4 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[0][2] * residual[0][2] + residual[0][3] * residual[0][3] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[1][2] * residual[1][2] + residual[1][3] * residual[1][3] + residual[2][0] * residual[2][0] + residual[2][1] * residual[2][1] + residual[2][2] * residual[2][2] + residual[2][3] * residual[2][3];
  gl_FragColor = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat2x4 arg0 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform mat3x2 arg1 0.09 -1.19 1.3 0.08 1.25 1.08
uniform mat3x4 expected 2.0255 -0.7741 1.5451 1.4381001 0.07279999 -0.9928 -2.3764 -0.1228 -1.6252002 -0.36280003 -3.7194 -1.3318001
uniform float tolerance 5.8473226e-05
draw rect ortho 0 0 4 4
uniform mat2x4 arg0 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform mat3x2 arg1 -0.36 -0.53 -1.08 0.88 -0.6 -1.79
uniform mat3x4 expected 0.83809996 -0.024699954 1.3843 0.64849997 -1.6600001 1.3832 0.62080014 -1.0432 2.9291 -0.57609993 3.6037 2.1779
uniform float tolerance 5.985297e-05
draw rect ortho 4 0 4 4
uniform mat2x4 arg0 -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
uniform mat3x2 arg1 0.09 -1.19 1.3 0.08 1.25 1.08
uniform mat3x4 expected -0.97240007 0.0070999973 -0.7024 -1.3177 -1.2667999 -2.1423998 -2.0293999 0.4804 -0.47579995 -2.1904 -1.4799 1.5954001
