[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform bool arg0;
uniform bool arg1;
uniform bool arg2;

void main()
{
  bool result = (arg0 ? arg1 : arg2);
  gl_FragColor = vec4(result, 0.0, 0.0, 0.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform int arg0 0
uniform int arg1 0
uniform int arg2 0
draw rect ortho 0 0 4 4
uniform int arg0 0
uniform int arg1 0
uniform int arg2 1
draw rect ortho 4 0 4 4
uniform int arg0 0
uniform int arg1 1
uniform int arg2 0
draw rect ortho 8 0 4 4
uniform int arg0 0
uniform int arg1 1
uniform int arg2 1
draw rect ortho 12 0 4 4
uniform int arg0 1
uniform int arg1 0
uniform int arg2 0
draw rect ortho 16 0 4 4
uniform int arg0 1
uniform int arg1 0
uniform int arg2 1
draw rect ortho 20 0 4 4
uniform int arg0 1
uniform int arg1 1
uniform int arg2 0
draw rect ortho 24 0 4 4
uniform int arg0 1
uniform int arg1 1
uniform int arg2 1
draw rect ortho 28 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 0.0, 0.0, 0.0)
probe rect rgba (4, 0, 4, 4) (1.0, 0.0, 0.0, 0.0)
probe rect rgba (8, 0, 4, 4) (0.0, 0.0, 0.0, 0.0)
probe rect rgba (12, 0, 4, 4) (1.0, 0.0, 0.0, 0.0)
probe rect rgba (16, 0, 4, 4) (0.0, 0.0, 0.0, 0.0)
probe rect rgba (20, 0, 4, 4) (0.0, 0.0, 0.0, 0.0)
probe rect rgba (24, 0, 4, 4) (1.0, 0.0, 0.0, 0.0)
probe rect rgba (28, 0, 4, 4) (1.0, 0.0, 0.0, 0.0)
