[require]
GLSL >= 1.20

[vertex shader]
varying vec4 color;
uniform mat4x2 arg0;
uniform mat2x4 arg1;
uniform float tolerance;
uniform mat2 expected;

void main()
{
  gl_Position = gl_Vertex;
  mat2 result = (arg0 * arg1);
  mat2 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1];
  color = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat4x2 arg0 1.81 -1.16 -0.87 -1.52 0.81 0.25 0.65 -1.51
uniform mat2x4 arg1 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform mat2x2 expected -0.4368 0.6256 -5.5169997 2.5332
uniform float tolerance 6.118543e-05
draw rect ortho 0 0 4 4
uniform mat4x2 arg0 1.81 -1.16 -0.87 -1.52 0.81 0.25 0.65 -1.51
uniform mat2x4 arg1 -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
uniform mat2x2 expected -1.5122999 2.8254998 2.5677 -2.2496
uniform float tolerance 4.6823374e-05
draw rect ortho 4 0 4 4
uniform mat4x2 arg0 1.93 0.49 -1.63 0.27 0.29 0.14 1.6 0.94
uniform mat2x4 arg1 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform mat2x2 expected 1.0762 -0.4 -6.5741 -2.0064
uniform float tolerance 6.9686896e-05
draw rect ortho 8 0 4 4
uniform mat4x2 arg0 1.93 0.49 -1.63 0.27 0.29 0.14 1.6 0.94
uniform mat2x4 arg1 -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
uniform mat2x2 expected 0.7235001 -0.8832 3.5844 1.4555
uniform float tolerance 4.0335963e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
