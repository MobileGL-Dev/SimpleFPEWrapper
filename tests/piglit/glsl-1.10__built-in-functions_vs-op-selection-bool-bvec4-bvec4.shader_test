[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform bool arg0;
uniform bvec4 arg1;
uniform bvec4 arg2;

void main()
{
  gl_Position = gl_Vertex;
  bvec4 result = (arg0 ? arg1 : arg2);
  color = vec4(result);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

