[require]
GLSL >= 1.20

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform mat4x2 arg0;
uniform mat4x2 arg1;
uniform float tolerance;
uniform mat4x2 expected;

void main()
{
  mat4x2 result = (arg0 + arg1);
  mat4x2 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[2][0] * residual[2][0] + residual[2][1] * residual[2][1] + residual[3][0] * residual[3][0] + residual[3][1] * residual[3][1];
  gl_FragColor = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat4x2 arg0 1.81 -1.16 -0.87 -1.52 0.81 0.25 0.65 -1.51
uniform mat4x2 arg1 1.81 -1.16 -0.87 -1.52 0.81 0.25 0.65 -1.51
uniform mat4x2 expected 3.62 -2.32 -1.74 -3.04 1.62 0.5 1.3 -3.02
uniform float tolerance 6.666393e-05
draw rect ortho 0 0 4 4
uniform mat4x2 arg0 1.81 -1.16 -0.87 -1.52 0.81 0.25 0.65 -1.51
uniform mat4x2 arg1 1.93 0.49 -1.63 0.27 0.29 0.14 1.6 0.94
uniform mat4x2 expected 3.7399998 -0.66999996 -2.5 -1.25 1.1 0.39 2.25 -0.57
uniform float tolerance 5.3850254e-05
draw rect ortho 4 0 4 4
uniform mat4x2 arg0 1.93 0.49 -1.63 0.27 0.29 0.14 1.6 0.94
uniform mat4x2 arg1 1.81 -1.16 -0.87 -1.52 0.81 0.25 0.65 -1.51
uniform mat4x2 expected 3.7399998 -0.66999996 -2.5 -1.25 1.1 0.39 2.25 -0.57
uniform float tolerance 5.3850254e-05
draw rect ortho 8 0 4 4
uniform mat4x2 arg0 1.93 0.49 -1.63 0.27 0.29 0.14 1.6 0.94
uniform mat4x2 arg1 1.93 0.49 -1.63 0.27 0.29 0.14 1.6 0.94
uniform mat4x2 expected 3.86 0.98 -3.26 0.54 0.58 0.28 3.2 1.88
uniform float tolerance 6.400656e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
