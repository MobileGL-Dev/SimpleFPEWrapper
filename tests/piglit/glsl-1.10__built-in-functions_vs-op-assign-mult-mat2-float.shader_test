[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform mat2 arg0;
uniform float arg1;
uniform float tolerance;
uniform mat2 expected;

void main()
{
  gl_Position = gl_Vertex;
  mat2 result = arg0;
  result *= arg1;
  mat2 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1];
  color = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat2x2 arg0 1.6 1.53 0.76 -1.0
uniform float arg1 0.0
uniform mat2x2 expected 0.0 0.0 0.0 0.0
uniform float tolerance 0.0
draw rect ortho 0 0 4 4
uniform mat2x2 arg0 1.6 1.53 0.76 -1.0
uniform float arg1 -1.33
uniform mat2x2 expected -2.128 -2.0349 -1.0108 1.33
uniform float tolerance 3.3852353e-05
draw rect ortho 4 0 4 4
uniform mat2x2 arg0 1.6 1.53 0.76 -1.0
uniform float arg1 0.85
uniform mat2x2 expected 1.36 1.3005 0.646 -0.85
uniform float tolerance 2.1634964e-05
draw rect ortho 8 0 4 4
uniform mat2x2 arg0 -0.13 -1.4 -0.87 1.4
uniform float arg1 0.0
uniform mat2x2 expected 0.0 0.0 0.0 0.0
uniform float tolerance 0.0
draw rect ortho 12 0 4 4
uniform mat2x2 arg0 -0.13 -1.4 -0.87 1.4
uniform float arg1 -1.33
uniform mat2x2 expected 0.1729 1.862 1.1571001 -1.862
uniform float tolerance 2.881469e-05
draw rect ortho 16 0 4 4
uniform mat2x2 arg0 -0.13 -1.4 -0.87 1.4
uniform float arg1 0.85
uniform mat2x2 expected -0.1105 -1.19 -0.73950005 1.19
uniform float tolerance 1.8415403e-05
draw rect ortho 20 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (16, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (20, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
