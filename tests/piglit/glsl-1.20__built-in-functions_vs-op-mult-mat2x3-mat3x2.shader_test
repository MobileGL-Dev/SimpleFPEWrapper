[require]
GLSL >= 1.20

[vertex shader]
varying vec4 color;
uniform mat2x3 arg0;
uniform mat3x2 arg1;
uniform float tolerance;
uniform mat3 expected;

void main()
{
  gl_Position = gl_Vertex;
  mat3 result = (arg0 * arg1);
  mat3 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[0][2] * residual[0][2] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[1][2] * residual[1][2] + residual[2][0] * residual[2][0] + residual[2][1] * residual[2][1] + residual[2][2] * residual[2][2];
  color = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat2x3 arg0 -0.46 -0.45 1.03 1.94 -0.75 -0.5
uniform mat3x2 arg1 0.09 -1.19 1.3 0.08 1.25 1.08
uniform mat3x3 expected -2.3500001 0.85200006 0.68770003 -0.4428 -0.645 1.2989999 1.5202001 -1.3725001 0.74749994
uniform float tolerance 3.711382e-05
draw rect ortho 0 0 4 4
uniform mat2x3 arg0 -0.46 -0.45 1.03 1.94 -0.75 -0.5
uniform mat3x2 arg1 -0.36 -0.53 -1.08 0.88 -0.6 -1.79
uniform mat3x3 expected -0.86259997 0.5595 -0.10580002 2.204 -0.174 -1.5524 -3.1966 1.6125 0.27699998
uniform float tolerance 4.6109963e-05
draw rect ortho 4 0 4 4
uniform mat2x3 arg0 1.38 -1.27 1.0 -1.08 1.83 -0.74
uniform mat3x2 arg1 0.09 -1.19 1.3 0.08 1.25 1.08
uniform mat3x3 expected 1.4094001 -2.292 0.97060007 1.7075999 -1.5045999 1.2407999 0.5585999 0.38890016 0.45079997
uniform float tolerance 3.945572e-05
draw rect ortho 8 0 4 4
uniform mat2x3 arg0 1.38 -1.27 1.0 -1.08 1.83 -0.74
uniform mat3x2 arg1 -0.36 -0.53 -1.08 0.88 -0.6 -1.79
uniform mat3x3 expected 0.075599976 -0.51269996 0.03219997 -2.4408002 2.982 -1.7312001 1.1052 -2.5137 0.72459996
