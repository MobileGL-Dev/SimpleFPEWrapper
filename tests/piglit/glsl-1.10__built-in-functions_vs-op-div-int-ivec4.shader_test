[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform int arg0;
uniform ivec4 arg1;
uniform ivec4 expected;

void main()
{
  gl_Position = gl_Vertex;
  ivec4 result = (arg0 / arg1);
  color = result == expected ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform int arg0 12
uniform ivec4 arg1 -64 72 88 -76
uniform ivec4 expected 0 0 0 0
draw rect ortho 0 0 4 4
