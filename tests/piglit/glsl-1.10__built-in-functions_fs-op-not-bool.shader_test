[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform bool arg0;

void main()
{
  bool result = (! arg0);
  gl_FragColor = vec4(result, 0.0, 0.0, 0.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform int arg0 0
draw rect ortho 0 0 4 4
uniform int arg0 1
draw rect ortho 4 0 4 4
probe rect rgba (0, 0, 4, 4) (1.0, 0.0, 0.0, 0.0)
probe rect rgba (4, 0, 4, 4) (0.0, 0.0, 0.0, 0.0)
