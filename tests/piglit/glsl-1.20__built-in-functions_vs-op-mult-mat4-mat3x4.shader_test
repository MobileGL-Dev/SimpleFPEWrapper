uniform mat3x4 expected 2.0727 0.8774999 -0.19470002 -0.8934001 5.6176 -5.3436 -0.6267001 5.8465004 0.5144999 -0.24939997 -1.4609 -0.4222
uniform float tolerance 0.00010160087
