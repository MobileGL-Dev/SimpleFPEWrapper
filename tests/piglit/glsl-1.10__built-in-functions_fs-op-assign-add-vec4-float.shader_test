[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform vec4 arg0;
uniform float arg1;
uniform float tolerance;
uniform vec4 expected;

void main()
{
  vec4 result = arg0;
  result += arg1;
  gl_FragColor = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec4 arg0 -1.65 1.33 1.93 0.76
uniform float arg1 0.0
uniform vec4 expected -1.65 1.33 1.93 0.76
uniform float tolerance 2.965451e-05
draw rect ortho 0 0 4 4
uniform vec4 arg0 -1.65 1.33 1.93 0.76
uniform float arg1 -1.33
uniform vec4 expected -2.98 0.0 0.5999999 -0.57000005
uniform float tolerance 3.092782e-05
draw rect ortho 4 0 4 4
uniform vec4 arg0 -1.65 1.33 1.93 0.76
uniform float arg1 0.85
uniform vec4 expected -0.79999995 2.18 2.78 1.61
uniform float tolerance 3.96395e-05
draw rect ortho 8 0 4 4
uniform vec4 arg0 0.8 -0.15 -0.51 0.0
uniform float arg1 0.0
uniform vec4 expected 0.8 -0.15 -0.51 0.0
uniform float tolerance 9.605207e-06
draw rect ortho 12 0 4 4
uniform vec4 arg0 0.8 -0.15 -0.51 0.0
uniform float arg1 -1.33
uniform vec4 expected -0.53000003 -1.48 -1.84 -1.33
uniform float tolerance 2.7614851e-05
draw rect ortho 16 0 4 4
uniform vec4 arg0 0.8 -0.15 -0.51 0.0
uniform float arg1 0.85
uniform vec4 expected 1.6500001 0.70000005 0.34000003 0.85
uniform float tolerance 2.0126103e-05
draw rect ortho 20 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (16, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (20, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
