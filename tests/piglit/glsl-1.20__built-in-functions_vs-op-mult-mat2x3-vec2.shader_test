[require]
GLSL >= 1.20

[vertex shader]
varying vec4 color;
uniform mat2x3 arg0;
uniform vec2 arg1;
uniform float tolerance;
uniform vec3 expected;

void main()
{
  gl_Position = gl_Vertex;
  vec3 result = (arg0 * arg1);
  color = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat2x3 arg0 -0.46 -0.45 1.03 1.94 -0.75 -0.5
uniform vec2 arg1 -0.1 -1.2
uniform vec3 expected -2.282 0.94500005 0.49700004
uniform float tolerance 2.5194362e-05
draw rect ortho 0 0 4 4
uniform mat2x3 arg0 -0.46 -0.45 1.03 1.94 -0.75 -0.5
uniform vec2 arg1 -0.42 0.48
uniform vec3 expected 1.1244 -0.171 -0.6726
uniform float tolerance 1.3213278e-05
draw rect ortho 4 0 4 4
uniform mat2x3 arg0 1.38 -1.27 1.0 -1.08 1.83 -0.74
uniform vec2 arg1 -0.1 -1.2
uniform vec3 expected 1.1580001 -2.0690002 0.78800005
uniform float tolerance 2.4985335e-05
draw rect ortho 8 0 4 4
uniform mat2x3 arg0 1.38 -1.27 1.0 -1.08 1.83 -0.74
uniform vec2 arg1 -0.42 0.48
uniform vec3 expected -1.0979999 1.4118 -0.7752
uniform float tolerance 1.9492865e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
