[require]
GLSL >= 1.20

[vertex shader]
varying vec4 color;
uniform mat3x2 arg0;
uniform mat4x3 arg1;
uniform float tolerance;
uniform mat4x2 expected;

void main()
{
  gl_Position = gl_Vertex;
  mat4x2 result = (arg0 * arg1);
  mat4x2 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[2][0] * residual[2][0] + residual[2][1] * residual[2][1] + residual[3][0] * residual[3][0] + residual[3][1] * residual[3][1];
  color = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat3x2 arg0 0.09 -1.19 1.3 0.08 1.25 1.08
uniform mat4x3 arg1 -0.27 -0.17 -1.85 -1.38 -0.56 -1.29 -1.41 1.47 1.77 -0.12 1.86 0.01
uniform mat4x2 expected -2.5578 -1.6903001 -2.4647 0.20420006 3.9966 3.7071002 2.4197 0.3024
uniform float tolerance 7.153859e-05
draw rect ortho 0 0 4 4
uniform mat3x2 arg0 0.09 -1.19 1.3 0.08 1.25 1.08
uniform mat4x3 arg1 -0.47 -0.2 -1.39 -0.15 0.53 -0.19 1.97 -1.82 1.62 -1.05 -1.41 1.58
uniform mat4x2 expected -2.0398 -0.95790005 0.43799993 0.015700007 -0.16369997 -0.74030006 0.047500163 2.8431
uniform float tolerance 3.7323938e-05
draw rect ortho 4 0 4 4
uniform mat3x2 arg0 -0.36 -0.53 -1.08 0.88 -0.6 -1.79
uniform mat4x3 arg1 -0.27 -0.17 -1.85 -1.38 -0.56 -1.29 -1.41 1.47 1.77 -0.12 1.86 0.01
uniform mat4x2 expected 1.3908001 3.305 1.8756001 2.5477 -2.1420002 -1.1273999 -1.9716 1.6825
uniform float tolerance 5.95342e-05
draw rect ortho 8 0 4 4
uniform mat3x2 arg0 -0.36 -0.53 -1.08 0.88 -0.6 -1.79
uniform mat4x3 arg1 -0.47 -0.2 -1.39 -0.15 0.53 -0.19 1.97 -1.82 1.62 -1.05 -1.41 1.58
uniform mat4x2 expected 1.2192 2.5612 -0.4044 0.886 0.28440005 -5.5455 0.9528 -3.5125
uniform float tolerance 7.2851675e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
