[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform ivec3 arg0;
uniform int arg1;
uniform ivec3 expected;

void main()
{
  gl_Position = gl_Vertex;
  ivec3 result = arg0;
  result -= arg1;
  color = result == expected ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform ivec3 arg0 -36 32 -88
uniform int arg1 12
uniform ivec3 expected -48 20 -100
draw rect ortho 0 0 4 4
uniform ivec3 arg0 -36 32 -88
uniform int arg1 -6
