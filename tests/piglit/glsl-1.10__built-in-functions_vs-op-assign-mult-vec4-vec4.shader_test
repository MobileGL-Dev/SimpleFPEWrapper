[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform vec4 arg0;
uniform vec4 arg1;
uniform float tolerance;
uniform vec4 expected;

void main()
{
  gl_Position = gl_Vertex;
  vec4 result = arg0;
  result *= arg1;
  color = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec4 arg0 -1.65 1.33 1.93 0.76
uniform vec4 arg1 -1.65 1.33 1.93 0.76
uniform vec4 expected 2.7224998 1.7689002 3.7248998 0.5776
uniform float tolerance 4.9748884e-05
draw rect ortho 0 0 4 4
uniform vec4 arg0 -1.65 1.33 1.93 0.76
uniform vec4 arg1 0.8 -0.15 -0.51 0.0
uniform vec4 expected -1.32 -0.19950001 -0.98429996 0.0
uniform float tolerance 1.658628e-05
draw rect ortho 4 0 4 4
uniform vec4 arg0 0.8 -0.15 -0.51 0.0
uniform vec4 arg1 -1.65 1.33 1.93 0.76
uniform vec4 expected -1.32 -0.19950001 -0.98429996 0.0
uniform float tolerance 1.658628e-05
draw rect ortho 8 0 4 4
uniform vec4 arg0 0.8 -0.15 -0.51 0.0
uniform vec4 arg1 0.8 -0.15 -0.51 0.0
uniform vec4 expected 0.64000005 0.0225 0.26009998 0.0
uniform float tolerance 6.912006e-06
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
