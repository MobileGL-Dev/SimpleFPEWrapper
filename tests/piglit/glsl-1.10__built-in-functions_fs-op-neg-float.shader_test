[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform float arg0;
uniform float tolerance;
uniform float expected;

void main()
{
  float result = (- arg0);
  gl_FragColor = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform float arg0 0.0
uniform float expected -0.0
uniform float tolerance 0.0
draw rect ortho 0 0 4 4
uniform float arg0 -1.33
uniform float expected 1.33
uniform float tolerance 1.33e-05
draw rect ortho 4 0 4 4
uniform float arg0 0.85
uniform float expected -0.85
uniform float tolerance 8.5e-06
draw rect ortho 8 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
