[require]
GLSL >= 1.20

[vertex shader]
varying vec4 color;
uniform mat3x4 arg0;
uniform mat3x4 arg1;
uniform float tolerance;
uniform mat3x4 expected;

void main()
{
  gl_Position = gl_Vertex;
  mat3x4 result = arg0;
  result += arg1;
  mat3x4 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[0][2] * residual[0][2] + residual[0][3] * residual[0][3] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[1][2] * residual[1][2] + residual[1][3] * residual[1][3] + residual[2][0] * residual[2][0] + residual[2][1] * residual[2][1] + residual[2][2] * residual[2][2] + residual[2][3] * residual[2][3];
  color = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat3x4 arg0 1.42 1.8 -1.88 1.37 -0.86 -1.74 -0.37 1.9 0.27 0.04 0.43 0.71
uniform mat3x4 arg1 1.42 1.8 -1.88 1.37 -0.86 -1.74 -0.37 1.9 0.27 0.04 0.43 0.71
uniform mat3x4 expected 2.84 3.6 -3.76 2.74 -1.72 -3.48 -0.74 3.8 0.54 0.08 0.86 1.42
uniform float tolerance 8.7052395e-05
draw rect ortho 0 0 4 4
uniform mat3x4 arg0 1.42 1.8 -1.88 1.37 -0.86 -1.74 -0.37 1.9 0.27 0.04 0.43 0.71
uniform mat3x4 arg1 -1.72 -0.31 0.14 0.4 0.09 -1.58 0.18 -0.77 0.45 1.92 -0.56 1.76
uniform mat3x4 expected -0.30000007 1.49 -1.74 1.77 -0.77 -3.3200002 -0.19 1.13 0.72 1.9599999 -0.13 2.47
uniform float tolerance 5.6459456e-05
draw rect ortho 4 0 4 4
uniform mat3x4 arg0 -1.72 -0.31 0.14 0.4 0.09 -1.58 0.18 -0.77 0.45 1.92 -0.56 1.76
uniform mat3x4 arg1 1.42 1.8 -1.88 1.37 -0.86 -1.74 -0.37 1.9 0.27 0.04 0.43 0.71
uniform mat3x4 expected -0.30000007 1.49 -1.74 1.77 -0.77 -3.3200002 -0.19 1.13 0.72 1.9599999 -0.13 2.47
uniform float tolerance 5.6459456e-05
draw rect ortho 8 0 4 4
uniform mat3x4 arg0 -1.72 -0.31 0.14 0.4 0.09 -1.58 0.18 -0.77 0.45 1.92 -0.56 1.76
uniform mat3x4 arg1 -1.72 -0.31 0.14 0.4 0.09 -1.58 0.18 -0.77 0.45 1.92 -0.56 1.76
uniform mat3x4 expected -3.44 -0.62 0.28 0.8 0.18 -3.16 0.36 -1.54 0.9 3.84 -1.12 3.52
uniform float tolerance 7.3929696e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
