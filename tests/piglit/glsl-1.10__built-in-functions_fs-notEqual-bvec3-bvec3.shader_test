[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform bvec3 arg0;
uniform bvec3 arg1;

void main()
{
  bvec3 result = notEqual(arg0, arg1);
  gl_FragColor = vec4(result, 0.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform ivec3 arg0 0 0 1
uniform ivec3 arg1 0 1 0
draw rect ortho 0 0 4 4
uniform ivec3 arg0 1 0 0
uniform ivec3 arg1 1 0 1
draw rect ortho 4 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 1.0, 0.0)
probe rect rgba (4, 0, 4, 4) (0.0, 0.0, 1.0, 0.0)
