[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform vec4 arg0;
uniform vec4 arg1;

void main()
{
  gl_Position = gl_Vertex;
  bvec4 result = notEqual(arg0, arg1);
  color = vec4(result);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec4 arg0 -1.5 -1.5 -1.5 -1.5
uniform vec4 arg1 -1.5 -0.5 0.5 1.5
draw rect ortho 0 0 4 4
uniform vec4 arg0 -0.5 -0.5 -0.5 -0.5
uniform vec4 arg1 -1.5 -0.5 0.5 1.5
draw rect ortho 4 0 4 4
uniform vec4 arg0 0.5 0.5 0.5 0.5
uniform vec4 arg1 -1.5 -0.5 0.5 1.5
draw rect ortho 8 0 4 4
uniform vec4 arg0 1.5 1.5 1.5 1.5
uniform vec4 arg1 -1.5 -0.5 0.5 1.5
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 1.0, 1.0)
probe rect rgba (4, 0, 4, 4) (1.0, 0.0, 1.0, 1.0)
probe rect rgba (8, 0, 4, 4) (1.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (1.0, 1.0, 1.0, 0.0)
