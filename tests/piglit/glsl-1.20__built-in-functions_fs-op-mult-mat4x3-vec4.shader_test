[require]
GLSL >= 1.20

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform mat4x3 arg0;
uniform vec4 arg1;
uniform float tolerance;
uniform vec3 expected;

void main()
{
  vec3 result = (arg0 * arg1);
  gl_FragColor = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat4x3 arg0 -0.27 -0.17 -1.85 -1.38 -0.56 -1.29 -1.41 1.47 1.77 -0.12 1.86 0.01
uniform vec4 arg1 -1.65 1.33 1.93 0.76
uniform vec3 expected -4.2023997 3.7863998 4.7605
uniform float tolerance 7.393196e-05
draw rect ortho 0 0 4 4
uniform mat4x3 arg0 -0.27 -0.17 -1.85 -1.38 -0.56 -1.29 -1.41 1.47 1.77 -0.12 1.86 0.01
uniform vec4 arg1 0.8 -0.15 -0.51 0.0
uniform vec3 expected 0.71009994 -0.8017 -2.1892
uniform float tolerance 2.4371217e-05
draw rect ortho 4 0 4 4
uniform mat4x3 arg0 -0.47 -0.2 -1.39 -0.15 0.53 -0.19 1.97 -1.82 1.62 -1.05 -1.41 1.58
uniform vec4 arg1 -1.65 1.33 1.93 0.76
uniform vec3 expected 3.5801 -3.5493 6.3682
uniform float tolerance 8.1221064e-05
draw rect ortho 8 0 4 4
uniform mat4x3 arg0 -0.47 -0.2 -1.39 -0.15 0.53 -0.19 1.97 -1.82 1.62 -1.05 -1.41 1.58
uniform vec4 arg1 0.8 -0.15 -0.51 0.0
uniform vec3 expected -1.3582 0.6887 -1.9097
uniform float tolerance 2.4425333e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
