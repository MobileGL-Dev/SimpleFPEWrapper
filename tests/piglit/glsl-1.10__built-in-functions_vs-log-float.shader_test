[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform float arg0;
uniform float tolerance;
uniform float expected;

void main()
{
  gl_Position = gl_Vertex;
  float result = log(arg0);
  color = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform float arg0 0.01
uniform float expected -4.6051702
uniform float tolerance 4.60517e-05
draw rect ortho 0 0 4 4
uniform float arg0 0.67333335
uniform float expected -0.39551476
uniform float tolerance 3.9551473e-06
draw rect ortho 4 0 4 4
uniform float arg0 1.3366667
uniform float expected 0.29017898
uniform float tolerance 2.90179e-06
draw rect ortho 8 0 4 4
uniform float arg0 2.0
uniform float expected 0.6931472
uniform float tolerance 6.931472e-06
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
