[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform vec4 arg0;
uniform float arg1;
uniform float tolerance;
uniform vec4 expected;

void main()
{
  vec4 result = max(arg0, arg1);
  gl_FragColor = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec4 arg0 -2.0 -0.6666667 0.6666667 2.0
uniform float arg1 -2.0
uniform vec4 expected -2.0 -0.6666667 0.6666667 2.0
uniform float tolerance 2.9814239e-05
draw rect ortho 0 0 4 4
uniform vec4 arg0 -2.0 -0.6666667 0.6666667 2.0
uniform float arg1 -0.6666667
uniform vec4 expected -0.6666667 -0.6666667 0.6666667 2.0
uniform float tolerance 2.3094011e-05
draw rect ortho 4 0 4 4
uniform vec4 arg0 -2.0 -0.6666667 0.6666667 2.0
uniform float arg1 0.6666667
uniform vec4 expected 0.6666667 0.6666667 0.6666667 2.0
uniform float tolerance 2.3094011e-05
draw rect ortho 8 0 4 4
uniform vec4 arg0 -2.0 -0.6666667 0.6666667 2.0
uniform float arg1 2.0
uniform vec4 expected 2.0 2.0 2.0 2.0
uniform float tolerance 4e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
