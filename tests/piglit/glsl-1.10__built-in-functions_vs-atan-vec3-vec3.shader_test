[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform vec3 arg0;
uniform vec3 arg1;
uniform float tolerance;
uniform vec3 expected;

void main()
{
  gl_Position = gl_Vertex;
  vec3 result = atan(arg0, arg1);
  color = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec3 arg0 0.0 0.0 0.0
uniform vec3 arg1 1e-10 -1e-10 0.1
uniform vec3 expected 0.0 3.1415927 0.0
uniform float tolerance 0.0031447741
draw rect ortho 0 0 4 4
uniform vec3 arg0 0.0 0.0 0.0
uniform vec3 arg1 -0.1 1.0 -1.0
uniform vec3 expected 3.1415927 0.0 3.1415927
uniform float tolerance 0.004444008
draw rect ortho 4 0 4 4
uniform vec3 arg0 0.0 0.0 0.0
uniform vec3 arg1 10.0 -10.0 10000000000.0
uniform vec3 expected 0.0 3.1415927 0.0
uniform float tolerance 0.0031447741
draw rect ortho 8 0 4 4
uniform vec3 arg0 0.0 1e-10 1e-10
uniform vec3 arg1 -10000000000.0 0.0 1e-10
uniform vec3 expected 3.1415927 1.5707964 0.7853982
uniform float tolerance 0.0035991466
draw rect ortho 12 0 4 4
uniform vec3 arg0 1e-10 1e-10 1e-10
uniform vec3 arg1 -1e-10 0.1 -0.1
uniform vec3 expected 2.3561945 1e-09 3.1415927
uniform float tolerance 0.0039282637
