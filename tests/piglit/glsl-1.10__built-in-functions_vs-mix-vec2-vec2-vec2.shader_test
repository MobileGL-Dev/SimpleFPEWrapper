[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform vec2 arg0;
uniform vec2 arg1;
uniform vec2 arg2;
uniform float tolerance;
uniform vec2 expected;

void main()
{
  gl_Position = gl_Vertex;
  vec2 result = mix(arg0, arg1, arg2);
  color = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec2 arg0 -2.0 -2.0
uniform vec2 arg1 -3.0 -3.0
uniform vec2 arg2 0.0 0.33333334
uniform vec2 expected -2.0 -2.3333333
uniform float tolerance 3.0731815e-05
draw rect ortho 0 0 4 4
uniform vec2 arg0 -2.0 -2.0
uniform vec2 arg1 -3.0 -3.0
uniform vec2 arg2 0.6666667 1.0
uniform vec2 expected -2.6666667 -3.0
uniform float tolerance 4.0138646e-05
draw rect ortho 4 0 4 4
uniform vec2 arg0 -2.0 -2.0
uniform vec2 arg1 3.0 3.0
uniform vec2 arg2 0.0 0.33333334
uniform vec2 expected -2.0 -0.33333328
uniform float tolerance 2.0275875e-05
draw rect ortho 8 0 4 4
uniform vec2 arg0 -2.0 -2.0
uniform vec2 arg1 3.0 3.0
uniform vec2 arg2 0.6666667 1.0
uniform vec2 expected 1.3333335 3.0
uniform float tolerance 3.2829525e-05
draw rect ortho 12 0 4 4
uniform vec2 arg0 2.0 2.0
uniform vec2 arg1 -3.0 -3.0
uniform vec2 arg2 0.0 0.33333334
uniform vec2 expected 2.0 0.33333328
uniform float tolerance 2.0275875e-05
draw rect ortho 16 0 4 4
uniform vec2 arg0 2.0 2.0
uniform vec2 arg1 -3.0 -3.0
uniform vec2 arg2 0.6666667 1.0
uniform vec2 expected -1.3333335 -3.0
uniform float tolerance 3.2829525e-05
draw rect ortho 20 0 4 4
uniform vec2 arg0 2.0 2.0
uniform vec2 arg1 3.0 3.0
uniform vec2 arg2 0.0 0.33333334
uniform vec2 expected 2.0 2.3333333
uniform float tolerance 3.0731815e-05
draw rect ortho 24 0 4 4
uniform vec2 arg0 2.0 2.0
uniform vec2 arg1 3.0 3.0
uniform vec2 arg2 0.6666667 1.0
uniform vec2 expected 2.6666667 3.0
uniform float tolerance 4.0138646e-05
draw rect ortho 28 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (16, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (20, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (24, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (28, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
