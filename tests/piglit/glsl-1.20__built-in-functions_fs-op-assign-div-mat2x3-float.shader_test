[require]
GLSL >= 1.20

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform mat2x3 arg0;
uniform float arg1;
uniform float tolerance;
uniform mat2x3 expected;

void main()
{
  mat2x3 result = arg0;
  result /= arg1;
  mat2x3 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[0][2] * residual[0][2] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[1][2] * residual[1][2];
  gl_FragColor = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat2x3 arg0 -0.46 -0.45 1.03 1.94 -0.75 -0.5
uniform float arg1 -1.33
uniform mat2x3 expected 0.34586465 0.33834586 -0.77443606 -1.4586467 0.56390977 0.37593985
uniform float tolerance 1.8495477e-05
draw rect ortho 0 0 4 4
uniform mat2x3 arg0 -0.46 -0.45 1.03 1.94 -0.75 -0.5
uniform float arg1 0.85
uniform mat2x3 expected -0.54117644 -0.52941173 1.2117647 2.282353 -0.8823529 -0.58823526
uniform float tolerance 2.893998e-05
draw rect ortho 4 0 4 4
uniform mat2x3 arg0 1.38 -1.27 1.0 -1.08 1.83 -0.74
uniform float arg1 -1.33
uniform mat2x3 expected -1.037594 0.95488715 -0.7518797 0.8120301 -1.3759398 0.55639094
uniform float tolerance 2.3272103e-05
draw rect ortho 8 0 4 4
uniform mat2x3 arg0 1.38 -1.27 1.0 -1.08 1.83 -0.74
uniform float arg1 0.85
uniform mat2x3 expected 1.6235293 -1.4941176 1.1764705 -1.2705883 2.1529412 -0.87058824
uniform float tolerance 3.6413996e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
