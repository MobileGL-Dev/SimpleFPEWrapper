[require]
GLSL >= 1.20

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform vec3 arg0;
uniform vec4 arg1;
uniform float tolerance;
uniform mat4x3 expected;

void main()
{
  mat4x3 result = outerProduct(arg0, arg1);
  mat4x3 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[0][2] * residual[0][2] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[1][2] * residual[1][2] + residual[2][0] * residual[2][0] + residual[2][1] * residual[2][1] + residual[2][2] * residual[2][2] + residual[3][0] * residual[3][0] + residual[3][1] * residual[3][1] + residual[3][2] * residual[3][2];
  gl_FragColor = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec3 arg0 -0.03 -0.85 -0.94
uniform vec4 arg1 -1.65 1.33 1.93 0.76
uniform mat4x3 expected 0.0495 1.4025 1.551 -0.0399 -1.1305001 -1.2502 -0.057899997 -1.6405 -1.8141999 -0.022799999 -0.646 -0.7144
uniform float tolerance 3.7592283e-05
draw rect ortho 0 0 4 4
uniform vec3 arg0 -0.03 -0.85 -0.94
uniform vec4 arg1 0.8 -0.15 -0.51 0.0
uniform mat4x3 expected -0.024 -0.68 -0.75200003 0.0045000003 0.12750001 0.141 0.015299999 0.4335 0.47939998 -0.0 -0.0 -0.0
uniform float tolerance 1.2176281e-05
draw rect ortho 4 0 4 4
uniform vec3 arg0 1.67 0.66 1.87
uniform vec4 arg1 -1.65 1.33 1.93 0.76
uniform mat4x3 expected -2.7554998 -1.089 -3.0855 2.2211 0.87780005 2.4871001 3.2231 1.2738 3.6090999 1.2692 0.5016 1.4212
uniform float tolerance 7.688128e-05
draw rect ortho 8 0 4 4
uniform vec3 arg0 1.67 0.66 1.87
uniform vec4 arg1 0.8 -0.15 -0.51 0.0
uniform mat4x3 expected 1.336 0.52800006 1.496 -0.2505 -0.09900001 -0.28050002 -0.85169995 -0.3366 -0.9537 0.0 0.0 0.0
uniform float tolerance 2.4902136e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
