[require]
GLSL >= 1.20

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform mat4x3 arg0;
uniform mat2x4 arg1;
uniform float tolerance;
uniform mat2x3 expected;

void main()
{
  mat2x3 result = (arg0 * arg1);
  mat2x3 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[0][2] * residual[0][2] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[1][2] * residual[1][2];
  gl_FragColor = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat4x3 arg0 -0.27 -0.17 -1.85 -1.38 -0.56 -1.29 -1.41 1.47 1.77 -0.12 1.86 0.01
uniform mat2x4 arg1 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform mat2x3 expected 3.5166 -2.1742 -2.344 1.8036 -4.3958 -0.17779967
uniform float tolerance 6.722767e-05
draw rect ortho 0 0 4 4
uniform mat4x3 arg0 -0.27 -0.17 -1.85 -1.38 -0.56 -1.29 -1.41 1.47 1.77 -0.12 1.86 0.01
uniform mat2x4 arg1 -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
uniform mat2x3 expected 4.7445 -0.68750006 1.1912999 -0.8187 2.7397 -0.35810006
uniform float tolerance 5.7189678e-05
draw rect ortho 4 0 4 4
uniform mat4x3 arg0 -0.47 -0.2 -1.39 -0.15 0.53 -0.19 1.97 -1.82 1.62 -1.05 -1.41 1.58
uniform mat2x4 arg1 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform mat2x3 expected -3.362 2.739 -2.9208 -0.8407999 4.9594 -1.9914
uniform float tolerance 7.523596e-05
draw rect ortho 8 0 4 4
uniform mat4x3 arg0 -0.47 -0.2 -1.39 -0.15 0.53 -0.19 1.97 -1.82 1.62 -1.05 -1.41 1.58
uniform mat2x4 arg1 -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
uniform mat2x3 expected -2.7219002 1.8056002 -0.37240008 -0.5888999 -2.6656 1.5429001
uniform float tolerance 4.5431687e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
