[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform float arg0;
uniform vec3 arg1;
uniform float tolerance;
uniform vec3 expected;

void main()
{
  vec3 result = (arg0 + arg1);
  gl_FragColor = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform float arg0 0.0
uniform vec3 arg1 -0.03 -0.85 -0.94
uniform vec3 expected -0.03 -0.85 -0.94
uniform float tolerance 1.2676751e-05
draw rect ortho 0 0 4 4
uniform float arg0 0.0
uniform vec3 arg1 1.67 0.66 1.87
uniform vec3 expected 1.67 0.66 1.87
uniform float tolerance 2.5925663e-05
draw rect ortho 4 0 4 4
uniform float arg0 -1.33
uniform vec3 arg1 -0.03 -0.85 -0.94
uniform vec3 expected -1.36 -2.18 -2.27
uniform float tolerance 3.4285422e-05
draw rect ortho 8 0 4 4
uniform float arg0 -1.33
uniform vec3 arg1 1.67 0.66 1.87
uniform vec3 expected 0.3399999 -0.67 0.53999996
uniform float tolerance 9.252567e-06
draw rect ortho 12 0 4 4
uniform float arg0 0.85
uniform vec3 arg1 -0.03 -0.85 -0.94
uniform vec3 expected 0.82000005 0.0 -0.089999974
uniform float tolerance 8.2492425e-06
draw rect ortho 16 0 4 4
uniform float arg0 0.85
uniform vec3 arg1 1.67 0.66 1.87
uniform vec3 expected 2.52 1.51 2.72
uniform float tolerance 4.003611e-05
draw rect ortho 20 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (16, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (20, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
