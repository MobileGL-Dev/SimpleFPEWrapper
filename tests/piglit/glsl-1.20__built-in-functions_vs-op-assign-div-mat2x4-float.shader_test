[require]
GLSL >= 1.20

[vertex shader]
varying vec4 color;
uniform mat2x4 arg0;
uniform float arg1;
uniform float tolerance;
uniform mat2x4 expected;

void main()
{
  gl_Position = gl_Vertex;
  mat2x4 result = arg0;
  result /= arg1;
  mat2x4 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[0][2] * residual[0][2] + residual[0][3] * residual[0][3] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[1][2] * residual[1][2] + residual[1][3] * residual[1][3];
  color = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat2x4 arg0 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform float arg1 -1.33
uniform mat2x4 expected -0.12030075 0.60150373 1.3082707 0.015037593 1.2706767 -0.443609 1.0751879 0.9097744
uniform float tolerance 2.4255316e-05
draw rect ortho 0 0 4 4
uniform mat2x4 arg0 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform float arg1 0.85
uniform mat2x4 expected 0.18823528 -0.9411765 -2.0470588 -0.02352941 -1.9882354 0.6941176 -1.6823528 -1.4235294
uniform float tolerance 3.7952435e-05
draw rect ortho 4 0 4 4
uniform mat2x4 arg0 -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
uniform float arg1 -1.33
uniform mat2x4 expected 0.7669172 1.2330827 1.1954887 -0.22556391 -0.55639094 0.09774435 -0.35338345 -0.84962404
uniform float tolerance 2.180503e-05
draw rect ortho 8 0 4 4
uniform mat2x4 arg0 -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
uniform float arg1 0.85
uniform mat2x4 expected -1.1999999 -1.9294116 -1.8705882 0.3529412 0.87058824 -0.15294117 0.55294114 1.3294117
uniform float tolerance 3.4118457e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
