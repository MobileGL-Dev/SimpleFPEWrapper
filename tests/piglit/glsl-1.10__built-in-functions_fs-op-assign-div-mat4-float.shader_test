[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform mat4 arg0;
uniform float arg1;
uniform float tolerance;
uniform mat4 expected;

void main()
{
  mat4 result = arg0;
  result /= arg1;
  mat4 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[0][2] * residual[0][2] + residual[0][3] * residual[0][3] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[1][2] * residual[1][2] + residual[1][3] * residual[1][3] + residual[2][0] * residual[2][0] + residual[2][1] * residual[2][1] + residual[2][2] * residual[2][2] + residual[2][3] * residual[2][3] + residual[3][0] * residual[3][0] + residual[3][1] * residual[3][1] + residual[3][2] * residual[3][2] + residual[3][3] * residual[3][3];
  gl_FragColor = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat4x4 arg0 -1.0 1.77 0.09 -0.91 -0.55 0.62 -0.71 -1.82 -1.08 0.48 -1.39 -1.43 1.79 -1.35 -1.21 0.72
uniform float arg1 -1.33
uniform mat4x4 expected 0.7518797 -1.330827 -0.067669176 0.68421054 0.41353384 -0.4661654 0.5338346 1.3684211 0.8120301 -0.36090225 1.0451127 1.0751879 -1.3458645 1.0150375 0.9097744 -0.5413534
uniform float tolerance 3.5150195e-05
draw rect ortho 0 0 4 4
uniform mat4x4 arg0 -1.0 1.77 0.09 -0.91 -0.55 0.62 -0.71 -1.82 -1.08 0.48 -1.39 -1.43 1.79 -1.35 -1.21 0.72
uniform float arg1 0.85
uniform mat4x4 expected -1.1764705 2.0823529 0.105882354 -1.0705882 -0.64705884 0.7294117 -0.83529407 -2.1411765 -1.2705883 0.56470585 -1.6352941 -1.6823528 2.1058822 -1.5882353 -1.4235294 0.84705883
uniform float tolerance 5.4999717e-05
draw rect ortho 4 0 4 4
