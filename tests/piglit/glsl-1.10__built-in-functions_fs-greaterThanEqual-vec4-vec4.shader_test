[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform vec4 arg0;
uniform vec4 arg1;

void main()
{
  bvec4 result = greaterThanEqual(arg0, arg1);
  gl_FragColor = vec4(result);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec4 arg0 -1.5 -1.5 -1.5 -1.5
uniform vec4 arg1 -1.5 -0.5 0.5 1.5
draw rect ortho 0 0 4 4
uniform vec4 arg0 -0.5 -0.5 -0.5 -0.5
uniform vec4 arg1 -1.5 -0.5 0.5 1.5
draw rect ortho 4 0 4 4
uniform vec4 arg0 0.5 0.5 0.5 0.5
uniform vec4 arg1 -1.5 -0.5 0.5 1.5
draw rect ortho 8 0 4 4
uniform vec4 arg0 1.5 1.5 1.5 1.5
uniform vec4 arg1 -1.5 -0.5 0.5 1.5
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (1.0, 0.0, 0.0, 0.0)
probe rect rgba (4, 0, 4, 4) (1.0, 1.0, 0.0, 0.0)
probe rect rgba (8, 0, 4, 4) (1.0, 1.0, 1.0, 0.0)
probe rect rgba (12, 0, 4, 4) (1.0, 1.0, 1.0, 1.0)
