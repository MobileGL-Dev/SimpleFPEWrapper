[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform int arg0;
uniform ivec4 arg1;
uniform ivec4 expected;

void main()
{
  ivec4 result = (arg0 + arg1);
  gl_FragColor = result == expected ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform int arg0 12
uniform ivec4 arg1 -64 72 88 -76
uniform ivec4 expected -52 84 100 -64
draw rect ortho 0 0 4 4
uniform int arg0 12
uniform ivec4 arg1 64 72 88 76
uniform ivec4 expected 76 84 100 88
draw rect ortho 4 0 4 4
uniform int arg0 12
uniform ivec4 arg1 -24 40 -23 64
uniform ivec4 expected -12 52 -11 76
draw rect ortho 8 0 4 4
