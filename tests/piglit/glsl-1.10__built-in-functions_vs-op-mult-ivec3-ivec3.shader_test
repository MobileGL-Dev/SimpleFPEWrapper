[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform ivec3 arg0;
uniform ivec3 arg1;
uniform ivec3 expected;

void main()
{
  gl_Position = gl_Vertex;
  ivec3 result = (arg0 * arg1);
  color = result == expected ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform ivec3 arg0 -36 32 -88
uniform ivec3 arg1 -36 32 -88
uniform ivec3 expected 1296 1024 7744
draw rect ortho 0 0 4 4
uniform ivec3 arg0 -36 32 -88
uniform ivec3 arg1 36 32 88
uniform ivec3 expected -1296 1024 -7744
draw rect ortho 4 0 4 4
uniform ivec3 arg0 -36 32 -88
uniform ivec3 arg1 59 77 68
uniform ivec3 expected -2124 2464 -5984
draw rect ortho 8 0 4 4
uniform ivec3 arg0 36 32 88
uniform ivec3 arg1 -36 32 -88
uniform ivec3 expected -1296 1024 -7744
