[require]
GLSL >= 1.20

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform float arg0;
uniform mat2x3 arg1;
uniform float tolerance;
uniform mat2x3 expected;

void main()
{
  mat2x3 result = (arg0 - arg1);
  mat2x3 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[0][2] * residual[0][2] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[1][2] * residual[1][2];
  gl_FragColor = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform float arg0 0.0
uniform mat2x3 arg1 -0.46 -0.45 1.03 1.94 -0.75 -0.5
uniform mat2x3 expected 0.46 0.45 -1.03 -1.94 0.75 0.5
uniform float tolerance 2.4598983e-05
draw rect ortho 0 0 4 4
uniform float arg0 0.0
uniform mat2x3 arg1 1.38 -1.27 1.0 -1.08 1.83 -0.74
uniform mat2x3 expected -1.38 1.27 -1.0 1.08 -1.83 0.74
uniform float tolerance 3.09519e-05
draw rect ortho 4 0 4 4
uniform float arg0 -1.33
uniform mat2x3 arg1 -0.46 -0.45 1.03 1.94 -0.75 -0.5
uniform mat2x3 expected -0.87 -0.88000005 -2.3600001 -3.27 -0.58000004 -0.83000004
uniform float tolerance 4.3380987e-05
draw rect ortho 8 0 4 4
uniform float arg0 -1.33
uniform mat2x3 arg1 1.38 -1.27 1.0 -1.08 1.83 -0.74
uniform mat2x3 expected -2.71 -0.060000062 -2.33 -0.25 -3.16 -0.59000003
uniform float tolerance 4.8138136e-05
draw rect ortho 12 0 4 4
uniform float arg0 0.85
uniform mat2x3 arg1 -0.46 -0.45 1.03 1.94 -0.75 -0.5
uniform mat2x3 expected 1.3100001 1.3 -0.17999995 -1.09 1.6 1.35
uniform float tolerance 3.0015164e-05
draw rect ortho 16 0 4 4
uniform float arg0 0.85
