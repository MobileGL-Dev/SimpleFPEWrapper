[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform ivec2 arg0;
uniform int arg1;
uniform ivec2 expected;

void main()
{
  gl_Position = gl_Vertex;
  ivec2 result = (arg0 + arg1);
  color = result == expected ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform ivec2 arg0 38 35
uniform int arg1 12
uniform ivec2 expected 50 47
draw rect ortho 0 0 4 4
