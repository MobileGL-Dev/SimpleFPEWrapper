[require]
GLSL >= 1.20

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform vec2 arg0;
uniform mat4x2 arg1;
uniform float tolerance;
uniform vec4 expected;

void main()
{
  vec4 result = (arg0 * arg1);
  gl_FragColor = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec2 arg0 -0.1 -1.2
uniform mat4x2 arg1 1.81 -1.16 -0.87 -1.52 0.81 0.25 0.65 -1.51
uniform vec4 expected 1.211 1.911 -0.381 1.7470001
uniform float tolerance 2.8836803e-05
draw rect ortho 0 0 4 4
uniform vec2 arg0 -0.1 -1.2
uniform mat4x2 arg1 1.93 0.49 -1.63 0.27 0.29 0.14 1.6 0.94
uniform vec4 expected -0.781 -0.16100003 -0.19700001 -1.288
uniform float tolerance 1.527624e-05
draw rect ortho 4 0 4 4
uniform vec2 arg0 -0.42 0.48
uniform mat4x2 arg1 1.81 -1.16 -0.87 -1.52 0.81 0.25 0.65 -1.51
uniform vec4 expected -1.3169999 -0.3642 -0.22019999 -0.99779993
uniform float tolerance 1.7062308e-05
draw rect ortho 8 0 4 4
uniform vec2 arg0 -0.42 0.48
uniform mat4x2 arg1 1.93 0.49 -1.63 0.27 0.29 0.14 1.6 0.94
uniform vec4 expected -0.57539994 0.8142 -0.054599993 -0.2208
uniform float tolerance 1.0226146e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
