[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform float arg0;
uniform float arg1;

void main()
{
  if((arg0 > arg1))
    gl_FragColor = vec4(1.0, 1.0, 0.0, 1.0);
  else
    gl_FragColor = vec4(0.0, 0.0, 1.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform float arg0 0.0
uniform float arg1 0.0
draw rect ortho 0 0 4 4
uniform float arg0 0.0
uniform float arg1 -1.33
draw rect ortho 4 0 4 4
uniform float arg0 0.0
uniform float arg1 0.85
draw rect ortho 8 0 4 4
uniform float arg0 -1.33
uniform float arg1 0.0
draw rect ortho 12 0 4 4
uniform float arg0 -1.33
uniform float arg1 -1.33
draw rect ortho 16 0 4 4
uniform float arg0 -1.33
uniform float arg1 0.85
draw rect ortho 20 0 4 4
uniform float arg0 0.85
uniform float arg1 0.0
draw rect ortho 24 0 4 4
uniform float arg0 0.85
uniform float arg1 -1.33
draw rect ortho 28 0 4 4
uniform float arg0 0.85
uniform float arg1 0.85
draw rect ortho 32 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 0.0, 1.0, 1.0)
probe rect rgba (4, 0, 4, 4) (1.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 0.0, 1.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 0.0, 1.0, 1.0)
probe rect rgba (16, 0, 4, 4) (0.0, 0.0, 1.0, 1.0)
probe rect rgba (20, 0, 4, 4) (0.0, 0.0, 1.0, 1.0)
probe rect rgba (24, 0, 4, 4) (1.0, 1.0, 0.0, 1.0)
probe rect rgba (28, 0, 4, 4) (1.0, 1.0, 0.0, 1.0)
probe rect rgba (32, 0, 4, 4) (0.0, 0.0, 1.0, 1.0)
