[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform int arg0;
uniform ivec2 arg1;
uniform ivec2 expected;

void main()
{
  ivec2 result = (arg0 * arg1);
  gl_FragColor = result == expected ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform int arg0 12
uniform ivec2 arg1 38 35
uniform ivec2 expected 456 420
draw rect ortho 0 0 4 4
uniform int arg0 12
uniform ivec2 arg1 64 -9
uniform ivec2 expected 768 -108
draw rect ortho 4 0 4 4
