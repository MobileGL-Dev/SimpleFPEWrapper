[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform float arg0;
uniform float arg1;
uniform float tolerance;
uniform float expected;

void main()
{
  gl_Position = gl_Vertex;
  float result = step(arg0, arg1);
  color = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform float arg0 -2.0
uniform float arg1 -2.0
uniform float expected 1.0
uniform float tolerance 1e-05
draw rect ortho 0 0 4 4
uniform float arg0 -2.0
uniform float arg1 -0.6666667
uniform float expected 1.0
uniform float tolerance 1e-05
