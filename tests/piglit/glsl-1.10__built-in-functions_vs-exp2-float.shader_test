[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform float arg0;
uniform float tolerance;
uniform float expected;

void main()
{
  gl_Position = gl_Vertex;
  float result = exp2(arg0);
  color = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform float arg0 -2.0
uniform float expected 0.25
uniform float tolerance 2.5e-06
draw rect ortho 0 0 4 4
uniform float arg0 -0.6666667
uniform float expected 0.62996054
uniform float tolerance 6.299605e-06
draw rect ortho 4 0 4 4
uniform float arg0 0.6666667
uniform float expected 1.587401
uniform float tolerance 1.5874011e-05
draw rect ortho 8 0 4 4
uniform float arg0 2.0
uniform float expected 4.0
uniform float tolerance 4e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
