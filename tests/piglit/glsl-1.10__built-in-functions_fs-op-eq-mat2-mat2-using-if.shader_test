[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform mat2 arg0;
uniform mat2 arg1;

void main()
{
  if((arg0 == arg1))
    gl_FragColor = vec4(1.0, 1.0, 0.0, 1.0);
  else
    gl_FragColor = vec4(0.0, 0.0, 1.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat2x2 arg0 1.6 1.53 0.76 -1.0
uniform mat2x2 arg1 1.6 1.53 0.76 -1.0
draw rect ortho 0 0 4 4
uniform mat2x2 arg0 1.6 1.53 0.76 -1.0
uniform mat2x2 arg1 -0.13 -1.4 -0.87 1.4
draw rect ortho 4 0 4 4
uniform mat2x2 arg0 -0.13 -1.4 -0.87 1.4
uniform mat2x2 arg1 1.6 1.53 0.76 -1.0
draw rect ortho 8 0 4 4
uniform mat2x2 arg0 -0.13 -1.4 -0.87 1.4
uniform mat2x2 arg1 -0.13 -1.4 -0.87 1.4
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (1.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 0.0, 1.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 0.0, 1.0, 1.0)
probe rect rgba (12, 0, 4, 4) (1.0, 1.0, 0.0, 1.0)
