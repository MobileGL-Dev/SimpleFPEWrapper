[require]
GLSL >= 1.20

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform vec2 arg0;
uniform vec2 arg1;
uniform float tolerance;
uniform mat2 expected;

void main()
{
  mat2 result = outerProduct(arg0, arg1);
  mat2 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1];
  gl_FragColor = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec2 arg0 -0.1 -1.2
uniform vec2 arg1 -0.1 -1.2
uniform mat2x2 expected 0.010000001 0.120000005 0.120000005 1.44
uniform float tolerance 1.4500001e-05
draw rect ortho 0 0 4 4
uniform vec2 arg0 -0.1 -1.2
uniform vec2 arg1 -0.42 0.48
uniform mat2x2 expected 0.042 0.504 -0.048 -0.57600003
uniform float tolerance 7.680234e-06
draw rect ortho 4 0 4 4
uniform vec2 arg0 -0.42 0.48
uniform vec2 arg1 -0.1 -1.2
uniform mat2x2 expected 0.042 -0.048 0.504 -0.57600003
uniform float tolerance 7.680234e-06
draw rect ortho 8 0 4 4
uniform vec2 arg0 -0.42 0.48
uniform vec2 arg1 -0.42 0.48
uniform mat2x2 expected 0.17639999 -0.20159999 -0.20159999 0.2304
uniform float tolerance 4.0679997e-06
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
