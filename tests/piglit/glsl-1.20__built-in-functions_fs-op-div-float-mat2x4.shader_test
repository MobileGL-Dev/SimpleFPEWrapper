uniform mat2x4 arg1 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform mat2x4 expected -8.3125 1.6625 0.7643678 66.5 0.78698224 -2.2542374 0.93007 1.0991735
uniform float tolerance 0.0006710045
