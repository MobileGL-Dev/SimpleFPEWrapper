[require]
GLSL >= 1.20

[vertex shader]
varying vec4 color;
uniform mat3x4 arg0;
uniform mat3 arg1;
uniform float tolerance;
uniform mat3x4 expected;

void main()
{
  gl_Position = gl_Vertex;
  mat3x4 result = arg0;
  result *= arg1;
  mat3x4 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[0][2] * residual[0][2] + residual[0][3] * residual[0][3] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[1][2] * residual[1][2] + residual[1][3] * residual[1][3] + residual[2][0] * residual[2][0] + residual[2][1] * residual[2][1] + residual[2][2] * residual[2][2] + residual[2][3] * residual[2][3];
  color = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat3x4 arg0 1.42 1.8 -1.88 1.37 -0.86 -1.74 -0.37 1.9 0.27 0.04 0.43 0.71
uniform mat3x3 arg1 -1.11 0.13 0.56 1.67 1.09 0.95 -0.41 -0.02 0.24
uniform mat3x4 expected -1.5367999 -2.2017999 2.2795 -0.87610006 1.6904998 1.1473998 -3.1344 5.0334 -0.5002 -0.6936 0.8814 -0.4293
uniform float tolerance 7.362044e-05
draw rect ortho 0 0 4 4
uniform mat3x4 arg0 1.42 1.8 -1.88 1.37 -0.86 -1.74 -0.37 1.9 0.27 0.04 0.43 0.71
uniform mat3x3 arg1 -1.69 -1.09 -1.53 -0.46 1.75 -0.7 -0.18 2.0 -1.47
uniform mat3x4 expected -1.8755 -1.2066 2.9226 -5.4726 -2.3472 -3.901 -0.083699994 2.1978 -2.3725 -3.8628001 -1.0337 2.5097
uniform float tolerance 9.846112e-05
draw rect ortho 4 0 4 4
uniform mat3x4 arg0 -1.72 -0.31 0.14 0.4 0.09 -1.58 0.18 -0.77 0.45 1.92 -0.56 1.76
uniform mat3x3 arg1 -1.11 0.13 0.56 1.67 1.09 0.95 -0.41 -0.02 0.24
uniform mat3x4 expected 2.1729 1.2139 -0.4456 0.44149998 -2.3468 -0.41590014 -0.10199998 1.5007 0.8114 0.6195 -0.1954 0.2738
