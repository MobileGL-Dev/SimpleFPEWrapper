[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform ivec3 arg0;
uniform int arg1;
uniform ivec3 expected;

void main()
{
  ivec3 result = arg0;
  result *= arg1;
  gl_FragColor = result == expected ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform ivec3 arg0 -36 32 -88
uniform int arg1 12
uniform ivec3 expected -432 384 -1056
draw rect ortho 0 0 4 4
uniform ivec3 arg0 -36 32 -88
uniform int arg1 -6
uniform ivec3 expected 216 -192 528
draw rect ortho 4 0 4 4
uniform ivec3 arg0 -36 32 -88
uniform int arg1 76
uniform ivec3 expected -2736 2432 -6688
