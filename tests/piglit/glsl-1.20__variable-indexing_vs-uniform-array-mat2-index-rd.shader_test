[require]
GLSL >= 1.20

[vertex shader]
uniform int index;
uniform vec2 expect;
uniform mat2x2[3] m = mat2x2[3](mat2x2(1.0, 2.0, 3.0, 4.0), mat2x2(5.0, 6.0, 7.0, 8.0), mat2x2(9.0, 10.0, 11.0, 12.0));
varying vec4 color;
void main()
{
  gl_Position = gl_ModelViewProjectionMatrix * gl_Vertex;
    color = (m[index][1] == expect) ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
uniform int index;
uniform vec2 expect;
uniform mat2x2[3] m = mat2x2[3](mat2x2(1.0, 2.0, 3.0, 4.0), mat2x2(5.0, 6.0, 7.0, 8.0), mat2x2(9.0, 10.0, 11.0, 12.0));
varying vec4 color;
void main()
{
    gl_FragColor = color;
}


[test]
clear color 0.5 0.5 0.5 0.5
clear
ortho
uniform int index 0



uniform vec2 expect 3 4
draw rect 20 5 10 10
probe rgb 25 10 0.0 1.0 0.0

uniform int index 1



uniform vec2 expect 7 8
draw rect 60 5 10 10
probe rgb 65 10 0.0 1.0 0.0

uniform int index 2



uniform vec2 expect 11 12
draw rect 100 5 10 10
probe rgb 105 10 0.0 1.0 0.0

