[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform bvec2 arg0;
uniform bvec2 arg1;

void main()
{
  gl_Position = gl_Vertex;
  bvec2 result = equal(arg0, arg1);
  color = vec4(result, 0.0, 0.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform ivec2 arg0 0 0
uniform ivec2 arg1 0 1
draw rect ortho 0 0 4 4
uniform ivec2 arg0 1 1
uniform ivec2 arg1 0 1
draw rect ortho 4 0 4 4
probe rect rgba (0, 0, 4, 4) (1.0, 0.0, 0.0, 0.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 0.0)
