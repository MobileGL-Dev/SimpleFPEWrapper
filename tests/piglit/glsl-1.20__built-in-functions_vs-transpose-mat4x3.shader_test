[require]
GLSL >= 1.20

[vertex shader]
varying vec4 color;
uniform mat4x3 arg0;
uniform float tolerance;
uniform mat3x4 expected;

void main()
{
  gl_Position = gl_Vertex;
  mat3x4 result = transpose(arg0);
  mat3x4 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[0][2] * residual[0][2] + residual[0][3] * residual[0][3] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[1][2] * residual[1][2] + residual[1][3] * residual[1][3] + residual[2][0] * residual[2][0] + residual[2][1] * residual[2][1] + residual[2][2] * residual[2][2] + residual[2][3] * residual[2][3];
  color = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat4x3 arg0 -0.27 -0.17 -1.85 -1.38 -0.56 -1.29 -1.41 1.47 1.77 -0.12 1.86 0.01
uniform mat3x4 expected -0.27 -1.38 -1.41 -0.12 -0.17 -0.56 1.47 1.86 -1.85 -1.29 1.77 0.01
uniform float tolerance 4.261737e-05
draw rect ortho 0 0 4 4
uniform mat4x3 arg0 -0.47 -0.2 -1.39 -0.15 0.53 -0.19 1.97 -1.82 1.62 -1.05 -1.41 1.58
uniform mat3x4 expected -0.47 -0.15 1.97 -1.05 -0.2 0.53 -1.82 -1.41 -1.39 -0.19 1.62 1.58
uniform float tolerance 4.235233e-05
draw rect ortho 4 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
