[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform vec3 arg0;
uniform vec3 arg1;
uniform float tolerance;
uniform vec3 expected;

void main()
{
  gl_Position = gl_Vertex;
  vec3 result = reflect(arg0, arg1);
  color = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec3 arg0 -0.03 -0.85 -0.94
uniform vec3 arg1 -0.02366537 -0.6705188 -0.741515
uniform vec3 expected 0.03 0.8499999 0.94000006
uniform float tolerance 1.2676751e-05
draw rect ortho 0 0 4 4
uniform vec3 arg0 -0.03 -0.85 -0.94
uniform vec3 arg1 0.64414936 0.254574 0.72129303
uniform vec3 expected 1.1471545 -0.3847773 0.37813103
uniform float tolerance 1.267675e-05
draw rect ortho 4 0 4 4
uniform vec3 arg0 1.67 0.66 1.87
uniform vec3 arg1 -0.02366537 -0.6705188 -0.741515
uniform vec3 expected 1.5815532 -1.8459924 -0.9013331
uniform float tolerance 2.5925663e-05
draw rect ortho 8 0 4 4
uniform vec3 arg0 1.67 0.66 1.87
uniform vec3 arg1 0.64414936 0.254574 0.72129303
uniform vec3 expected -1.6699998 -0.6599999 -1.8699999
uniform float tolerance 2.5925661e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
