[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform vec3 arg0;
uniform vec3 arg1;
uniform vec3 arg2;
uniform float tolerance;
uniform vec3 expected;

void main()
{
  gl_Position = gl_Vertex;
  vec3 result = faceforward(arg0, arg1, arg2);
  color = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec3 arg0 -0.03 -0.85 -0.94
uniform vec3 arg1 -0.03 -0.85 -0.94
uniform vec3 arg2 -0.03 -0.85 -0.94
uniform vec3 expected 0.03 0.85 0.94
uniform float tolerance 1.2676751e-05
draw rect ortho 0 0 4 4
uniform vec3 arg0 -0.03 -0.85 -0.94
uniform vec3 arg1 -0.03 -0.85 -0.94
uniform vec3 arg2 1.67 0.66 1.87
uniform vec3 expected -0.03 -0.85 -0.94
