[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform vec2 arg0;
uniform vec2 arg1;
uniform float tolerance;
uniform vec2 expected;

void main()
{
  vec2 result = atan(arg0, arg1);
  gl_FragColor = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec2 arg0 0.0 0.0
uniform vec2 arg1 1e-10 -1e-10
uniform vec2 expected 0.0 3.1415927
uniform float tolerance 0.003143184
draw rect ortho 0 0 4 4
uniform vec2 arg0 0.0 0.0
uniform vec2 arg1 0.1 -0.1
uniform vec2 expected 0.0 3.1415927
uniform float tolerance 0.003143184
draw rect ortho 4 0 4 4
uniform vec2 arg0 0.0 0.0
uniform vec2 arg1 1.0 -1.0
uniform vec2 expected 0.0 3.1415927
uniform float tolerance 0.003143184
draw rect ortho 8 0 4 4
