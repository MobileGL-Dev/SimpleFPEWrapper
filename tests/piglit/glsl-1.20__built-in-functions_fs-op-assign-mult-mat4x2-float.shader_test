uniform mat4x2 arg0 1.81 -1.16 -0.87 -1.52 0.81 0.25 0.65 -1.51
uniform float arg1 0.85
uniform mat4x2 expected 1.5385 -0.986 -0.73950005 -1.292 0.68850005 0.2125 0.5525 -1.2835001
uniform float tolerance 2.8332171e-05
