[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform vec4 arg0;
uniform float tolerance;
uniform vec4 expected;

void main()
{
  vec4 result = normalize(arg0);
  gl_FragColor = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec4 arg0 -1.65 1.33 1.93 0.76
uniform vec4 expected -0.55640775 0.4484984 0.6508285 0.2562848
uniform float tolerance 1e-05
draw rect ortho 0 0 4 4
uniform vec4 arg0 0.8 -0.15 -0.51 0.0
uniform vec4 expected 0.83288157 -0.1561653 -0.530962 0.0
uniform float tolerance 1e-05
draw rect ortho 4 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
