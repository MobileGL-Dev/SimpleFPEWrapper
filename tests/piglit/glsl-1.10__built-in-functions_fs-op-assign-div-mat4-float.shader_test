uniform float arg1 -1.33
uniform mat4x4 expected -0.04511278 -1.2030075 -0.9398496 0.12030075 -0.98496234 0.2406015 -0.33834586 -0.33834586 -1.1428571 -0.3834586 -1.4285713 0.6616541 1.4736842 1.3834586 0.5413534 -0.29323307
uniform float tolerance 3.464183e-05
draw rect ortho 8 0 4 4
