[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform vec3 arg0;
uniform float arg1;
uniform float tolerance;
uniform vec3 expected;

void main()
{
  gl_Position = gl_Vertex;
  vec3 result = mod(arg0, arg1);
  color = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec3 arg0 -1.9 -0.6333333 0.6333333
uniform float arg1 -2.0
uniform vec3 expected -1.9 -0.6333333 -1.3666667
uniform float tolerance 2.424642e-05
draw rect ortho 0 0 4 4
uniform vec3 arg0 1.9 -1.9 -0.6333333
uniform float arg1 -2.0
uniform vec3 expected -0.100000024 -1.9 -0.6333333
uniform float tolerance 2.0052708e-05
draw rect ortho 4 0 4 4
uniform vec3 arg0 -1.9 -0.6333333 0.6333333
uniform float arg1 -0.6666667
uniform vec3 expected -0.5666666 -0.6333333 -0.03333336
