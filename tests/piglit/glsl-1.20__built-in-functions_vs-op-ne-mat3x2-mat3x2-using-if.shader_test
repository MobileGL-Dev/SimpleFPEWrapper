[require]
GLSL >= 1.20

[vertex shader]
varying vec4 color;
uniform mat3x2 arg0;
uniform mat3x2 arg1;

void main()
{
  gl_Position = gl_Vertex;
  if((arg0 != arg1))
    color = vec4(1.0, 1.0, 0.0, 1.0);
  else
    color = vec4(0.0, 0.0, 1.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat3x2 arg0 0.09 -1.19 1.3 0.08 1.25 1.08
uniform mat3x2 arg1 0.09 -1.19 1.3 0.08 1.25 1.08
draw rect ortho 0 0 4 4
uniform mat3x2 arg0 0.09 -1.19 1.3 0.08 1.25 1.08
uniform mat3x2 arg1 -0.36 -0.53 -1.08 0.88 -0.6 -1.79
draw rect ortho 4 0 4 4
uniform mat3x2 arg0 -0.36 -0.53 -1.08 0.88 -0.6 -1.79
uniform mat3x2 arg1 0.09 -1.19 1.3 0.08 1.25 1.08
draw rect ortho 8 0 4 4
uniform mat3x2 arg0 -0.36 -0.53 -1.08 0.88 -0.6 -1.79
uniform mat3x2 arg1 -0.36 -0.53 -1.08 0.88 -0.6 -1.79
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 0.0, 1.0, 1.0)
probe rect rgba (4, 0, 4, 4) (1.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (1.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 0.0, 1.0, 1.0)
