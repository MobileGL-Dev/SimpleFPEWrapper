[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform ivec2 arg0;
uniform ivec2 arg1;

void main()
{
  gl_Position = gl_Vertex;
  bvec2 result = lessThanEqual(arg0, arg1);
  color = vec4(result, 0.0, 0.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
