[require]
GLSL >= 1.20

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform mat3x2 arg0;
uniform mat2x3 arg1;
uniform float tolerance;
uniform mat2 expected;

void main()
{
  mat2 result = (arg0 * arg1);
  mat2 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1];
  gl_FragColor = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat3x2 arg0 0.09 -1.19 1.3 0.08 1.25 1.08
uniform mat2x3 arg1 -0.46 -0.45 1.03 1.94 -0.75 -0.5
uniform mat2x2 expected 0.6611 1.6238 -1.4253999 -2.9086
uniform float tolerance 3.6831374e-05
draw rect ortho 0 0 4 4
uniform mat3x2 arg0 0.09 -1.19 1.3 0.08 1.25 1.08
uniform mat2x3 arg1 1.38 -1.27 1.0 -1.08 1.83 -0.74
uniform mat2x2 expected -0.27679992 -0.6638 1.3568 0.6324001
uniform float tolerance 1.6607482e-05
draw rect ortho 4 0 4 4
uniform mat3x2 arg0 -0.36 -0.53 -1.08 0.88 -0.6 -1.79
uniform mat2x3 arg1 -0.46 -0.45 1.03 1.94 -0.75 -0.5
uniform mat2x2 expected 0.03360001 -1.9958999 0.4116 -0.7932
uniform float tolerance 2.1870817e-05
draw rect ortho 8 0 4 4
uniform mat3x2 arg0 -0.36 -0.53 -1.08 0.88 -0.6 -1.79
uniform mat2x3 arg1 1.38 -1.27 1.0 -1.08 1.83 -0.74
uniform mat2x2 expected 0.2748 -3.639 -1.1436001 3.5074
uniform float tolerance 5.1891726e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
