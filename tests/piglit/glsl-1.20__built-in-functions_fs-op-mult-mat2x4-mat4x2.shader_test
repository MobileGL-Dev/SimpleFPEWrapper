[require]
GLSL >= 1.20

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform mat2x4 arg0;
uniform mat4x2 arg1;
uniform float tolerance;
uniform mat4 expected;

void main()
{
  mat4 result = (arg0 * arg1);
  mat4 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[0][2] * residual[0][2] + residual[0][3] * residual[0][3] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[1][2] * residual[1][2] + residual[1][3] * residual[1][3] + residual[2][0] * residual[2][0] + residual[2][1] * residual[2][1] + residual[2][2] * residual[2][2] + residual[2][3] * residual[2][3] + residual[3][0] * residual[3][0] + residual[3][1] * residual[3][1] + residual[3][2] * residual[3][2] + residual[3][3] * residual[3][3];
  gl_FragColor = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat2x4 arg0 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform mat4x2 arg1 1.81 -1.16 -0.87 -1.52 0.81 0.25 0.65 -1.51
uniform mat4x4 expected 2.25 -2.1324 -1.4906 1.3674 2.4296 -0.20079994 3.6873999 1.8566 -0.29290003 -0.5005 -1.7669 -0.31870002 2.6559 -1.4109 1.0282999 1.8141
uniform float tolerance 7.324006e-05
draw rect ortho 0 0 4 4
uniform mat2x4 arg0 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform mat4x2 arg1 1.93 0.49 -1.63 0.27 0.29 0.14 1.6 0.94
uniform mat4x4 expected -0.51930004 -1.2549 -4.0589 -0.6315 -0.7171 1.4633 2.4501 -0.29410002 -0.19020002 -0.1494 -0.7048 -0.1752 -1.3326 -0.7254001 -4.1282 -1.1694
uniform float tolerance 6.9828624e-05
draw rect ortho 4 0 4 4
uniform mat2x4 arg0 -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
uniform mat4x2 arg1 1.81 -1.16 -0.87 -1.52 0.81 0.25 0.65 -1.51
uniform mat4x4 expected -2.7045999 -2.8175998 -3.4231 -0.7678 -0.23740001 1.6244 0.6689001 -1.9786 -0.6412 -1.3609 -1.1704 0.5255 -1.7803999 -0.86969995 -1.7432 -1.5113
uniform float tolerance 6.912042e-05
draw rect ortho 8 0 4 4
uniform mat2x4 arg0 -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
uniform mat4x2 arg1 1.93 0.49 -1.63 0.27 0.29 0.14 1.6 0.94
uniform mat4x4 expected -1.606 -3.2289 -2.8384 1.1327 1.8623999 2.6381 2.7186 -0.18390001 -0.19219999 -0.49379998 -0.3953 0.24520001 -0.9364 -2.7462 -2.1022 1.5422
uniform float tolerance 7.4773336e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
