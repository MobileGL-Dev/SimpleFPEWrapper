[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform float arg0;
uniform vec3 arg1;
uniform float tolerance;
uniform vec3 expected;

void main()
{
  vec3 result = step(arg0, arg1);
  gl_FragColor = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform float arg0 -2.0
uniform vec3 arg1 -2.0 -0.6666667 0.6666667
uniform vec3 expected 1.0 1.0 1.0
uniform float tolerance 1.7320508e-05
draw rect ortho 0 0 4 4
uniform float arg0 -2.0
uniform vec3 arg1 2.0 -2.0 -0.6666667
uniform vec3 expected 1.0 1.0 1.0
uniform float tolerance 1.7320508e-05
draw rect ortho 4 0 4 4
uniform float arg0 -0.6666667
uniform vec3 arg1 -2.0 -0.6666667 0.6666667
uniform vec3 expected 0.0 1.0 1.0
uniform float tolerance 1.4142135e-05
draw rect ortho 8 0 4 4
uniform float arg0 -0.6666667
uniform vec3 arg1 2.0 -2.0 -0.6666667
uniform vec3 expected 1.0 0.0 1.0
uniform float tolerance 1.4142135e-05
draw rect ortho 12 0 4 4
uniform float arg0 0.6666667
uniform vec3 arg1 -2.0 -0.6666667 0.6666667
uniform vec3 expected 0.0 0.0 1.0
uniform float tolerance 1e-05
draw rect ortho 16 0 4 4
uniform float arg0 0.6666667
uniform vec3 arg1 2.0 -2.0 -0.6666667
uniform vec3 expected 1.0 0.0 0.0
uniform float tolerance 1e-05
draw rect ortho 20 0 4 4
uniform float arg0 2.0
uniform vec3 arg1 -2.0 -0.6666667 0.6666667
uniform vec3 expected 0.0 0.0 0.0
uniform float tolerance 0.0
draw rect ortho 24 0 4 4
uniform float arg0 2.0
uniform vec3 arg1 2.0 -2.0 -0.6666667
uniform vec3 expected 1.0 0.0 0.0
uniform float tolerance 1e-05
draw rect ortho 28 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (16, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (20, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (24, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (28, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
