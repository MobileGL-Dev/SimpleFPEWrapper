[require]
GLSL >= 1.20

[vertex shader]
varying vec4 color;
uniform vec4 arg0;
uniform vec4 arg1;
uniform float tolerance;
uniform mat4 expected;

void main()
{
  gl_Position = gl_Vertex;
  mat4 result = outerProduct(arg0, arg1);
  mat4 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[0][2] * residual[0][2] + residual[0][3] * residual[0][3] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[1][2] * residual[1][2] + residual[1][3] * residual[1][3] + residual[2][0] * residual[2][0] + residual[2][1] * residual[2][1] + residual[2][2] * residual[2][2] + residual[2][3] * residual[2][3] + residual[3][0] * residual[3][0] + residual[3][1] * residual[3][1] + residual[3][2] * residual[3][2] + residual[3][3] * residual[3][3];
  color = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec4 arg0 -1.65 1.33 1.93 0.76
uniform vec4 arg1 -1.65 1.33 1.93 0.76
uniform mat4x4 expected 2.7224998 -2.1945 -3.1845 -1.254 -2.1945 1.7689002 2.5669 1.0108 -3.1845 2.5669 3.7248998 1.4668 -1.254 1.0108 1.4668 0.5776
uniform float tolerance 8.7939e-05
draw rect ortho 0 0 4 4
uniform vec4 arg0 -1.65 1.33 1.93 0.76
uniform vec4 arg1 0.8 -0.15 -0.51 0.0
uniform mat4x4 expected -1.32 1.064 1.544 0.608 0.2475 -0.19950001 -0.2895 -0.114 0.8415 -0.6783 -0.98429996 -0.38759997 -0.0 0.0 0.0 0.0
uniform float tolerance 2.8483772e-05
draw rect ortho 4 0 4 4
uniform vec4 arg0 0.8 -0.15 -0.51 0.0
uniform vec4 arg1 -1.65 1.33 1.93 0.76
uniform mat4x4 expected -1.32 0.2475 0.8415 -0.0 1.064 -0.19950001 -0.6783 0.0 1.544 -0.2895 -0.98429996 0.0 0.608 -0.114 -0.38759997 0.0
uniform float tolerance 2.8483772e-05
