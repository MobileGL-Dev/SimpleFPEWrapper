[require]
GLSL >= 1.20

[vertex shader]
varying vec4 color;
uniform mat4x2 arg0;
uniform mat3x4 arg1;
uniform float tolerance;
uniform mat3x2 expected;

void main()
{
  gl_Position = gl_Vertex;
  mat3x2 result = (arg0 * arg1);
  mat3x2 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[2][0] * residual[2][0] + residual[2][1] * residual[2][1];
  color = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat4x2 arg0 1.81 -1.16 -0.87 -1.52 0.81 0.25 0.65 -1.51
uniform mat3x4 arg1 1.42 1.8 -1.88 1.37 -0.86 -1.74 -0.37 1.9 0.27 0.04 0.43 0.71
uniform mat3x2 expected 0.37189984 -6.9219 0.8925 0.68090004 1.2637 -1.3385999
uniform float tolerance 7.259475e-05
draw rect ortho 0 0 4 4
uniform mat4x2 arg0 1.81 -1.16 -0.87 -1.52 0.81 0.25 0.65 -1.51
uniform mat3x4 arg1 -1.72 -0.31 0.14 0.4 0.09 -1.58 0.18 -0.77 0.45 1.92 -0.56 1.76
uniform mat3x2 expected -2.4701 1.8974 1.1828 3.5049 -0.16550007 -6.238
uniform float tolerance 7.894612e-05
draw rect ortho 4 0 4 4
uniform mat4x2 arg0 1.93 0.49 -1.63 0.27 0.29 0.14 1.6 0.94
uniform mat3x4 arg1 1.42 1.8 -1.88 1.37 -0.86 -1.74 -0.37 1.9 0.27 0.04 0.43 0.71
uniform mat3x2 expected 1.4534 2.2064 4.1091 0.84299994 1.7166 0.8707
uniform float tolerance 5.3179658e-05
draw rect ortho 8 0 4 4
uniform mat4x2 arg0 1.93 0.49 -1.63 0.27 0.29 0.14 1.6 0.94
uniform mat3x4 arg1 -1.72 -0.31 0.14 0.4 0.09 -1.58 0.18 -0.77 0.45 1.92 -0.56 1.76
uniform mat3x2 expected -2.1337 -0.5309 1.5693 -1.0811 0.39250007 2.3149
