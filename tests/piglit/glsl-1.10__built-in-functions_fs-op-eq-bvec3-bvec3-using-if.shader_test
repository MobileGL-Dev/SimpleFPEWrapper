[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform bvec3 arg0;
uniform bvec3 arg1;

void main()
{
  if((arg0 == arg1))
    gl_FragColor = vec4(1.0, 1.0, 0.0, 1.0);
  else
    gl_FragColor = vec4(0.0, 0.0, 1.0, 1.0);
}

