[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform vec4 arg0;
uniform vec4 arg1;
uniform float tolerance;
uniform vec4 expected;

void main()
{
  gl_Position = gl_Vertex;
  vec4 result = mod(arg0, arg1);
  color = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec4 arg0 -1.9 -1.9 -1.9 -1.9
uniform vec4 arg1 -2.0 -0.6666667 0.6666667 2.0
uniform vec4 expected -1.9 -0.5666666 0.10000008 0.100000024
uniform float tolerance 1.9877401e-05
draw rect ortho 0 0 4 4
uniform vec4 arg0 -0.6333333 -0.6333333 -0.6333333 -0.6333333
uniform vec4 arg1 -2.0 -0.6666667 0.6666667 2.0
uniform vec4 expected -0.6333333 -0.6333333 0.03333336 1.3666667
uniform float tolerance 1.6343534e-05
draw rect ortho 4 0 4 4
uniform vec4 arg0 0.6333333 0.6333333 0.6333333 0.6333333
uniform vec4 arg1 -2.0 -0.6666667 0.6666667 2.0
uniform vec4 expected -1.3666667 -0.03333336 0.6333333 0.6333333
uniform float tolerance 1.6343534e-05
draw rect ortho 8 0 4 4
uniform vec4 arg0 1.9 1.9 1.9 1.9
uniform vec4 arg1 -2.0 -0.6666667 0.6666667 2.0
uniform vec4 expected -0.100000024 -0.10000008 0.5666666 1.9
uniform float tolerance 1.9877401e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
