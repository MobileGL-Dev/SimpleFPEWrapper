[require]
GLSL >= 1.20

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform bool arg0;
uniform mat2x4 arg1;
uniform mat2x4 arg2;
uniform float tolerance;
uniform mat2x4 expected;

void main()
{
  mat2x4 result = (arg0 ? arg1 : arg2);
  mat2x4 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[0][2] * residual[0][2] + residual[0][3] * residual[0][3] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[1][2] * residual[1][2] + residual[1][3] * residual[1][3];
  gl_FragColor = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform int arg0 0
uniform mat2x4 arg1 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform mat2x4 arg2 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform mat2x4 expected 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform float tolerance 3.2259573e-05
draw rect ortho 0 0 4 4
uniform int arg0 0
uniform mat2x4 arg1 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform mat2x4 arg2 -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
