uniform mat2x4 arg1 -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
uniform mat2x4 expected 1.3039216 0.8109757 0.836478 -4.4333334 -1.7972974 10.23077 -2.8297873 -1.1769912
