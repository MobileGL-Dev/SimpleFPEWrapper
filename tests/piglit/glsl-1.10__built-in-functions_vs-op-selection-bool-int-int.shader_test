[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform bool arg0;
uniform int arg1;
uniform int arg2;
uniform int expected;

void main()
{
  gl_Position = gl_Vertex;
  int result = (arg0 ? arg1 : arg2);
  color = result == expected ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

