[require]
GLSL >= 1.20

[vertex shader]
varying vec4 color;
uniform mat3x2 arg0;
uniform float tolerance;
uniform mat2x3 expected;

void main()
{
  gl_Position = gl_Vertex;
  mat2x3 result = transpose(arg0);
  mat2x3 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[0][2] * residual[0][2] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[1][2] * residual[1][2];
  color = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat3x2 arg0 0.09 -1.19 1.3 0.08 1.25 1.08
uniform mat2x3 expected 0.09 1.3 1.25 -1.19 0.08 1.08
uniform float tolerance 2.418574e-05
draw rect ortho 0 0 4 4
uniform mat3x2 arg0 -0.36 -0.53 -1.08 0.88 -0.6 -1.79
uniform mat2x3 expected -0.36 -1.08 -0.6 -0.53 0.88 -1.79
uniform float tolerance 2.4321595e-05
draw rect ortho 4 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
