[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform vec3 arg0;
uniform vec3 arg1;
uniform float arg2;
uniform float tolerance;
uniform vec3 expected;

void main()
{
  gl_Position = gl_Vertex;
  vec3 result = refract(arg0, arg1, arg2);
  color = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec3 arg0 -0.02366537 -0.6705188 -0.741515
uniform vec3 arg1 -0.02366537 -0.6705188 -0.741515
uniform float arg2 0.5
uniform vec3 expected 0.02366537 0.6705188 0.741515
uniform float tolerance 1e-05
draw rect ortho 0 0 4 4
uniform vec3 arg0 -0.02366537 -0.6705188 -0.741515
uniform vec3 arg1 -0.02366537 -0.6705188 -0.741515
uniform float arg2 2.0
