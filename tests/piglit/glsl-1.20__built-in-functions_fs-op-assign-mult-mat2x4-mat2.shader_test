[require]
GLSL >= 1.20

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform mat2x4 arg0;
uniform mat2 arg1;
uniform float tolerance;
uniform mat2x4 expected;

void main()
{
  mat2x4 result = arg0;
  result *= arg1;
  mat2x4 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[0][2] * residual[0][2] + residual[0][3] * residual[0][3] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1] + residual[1][2] * residual[1][2] + residual[1][3] * residual[1][3];
  gl_FragColor = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat2x4 arg0 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform mat2x2 arg1 1.6 1.53 0.76 -1.0
uniform mat2x4 expected -2.3297 -0.37730008 -4.9719 -1.8833001 1.8116001 -1.198 0.10759996 1.1948
uniform float tolerance 6.323977e-05
draw rect ortho 0 0 4 4
uniform mat2x4 arg0 0.16 -0.8 -1.74 -0.02 -1.69 0.59 -1.43 -1.21
uniform mat2x2 arg1 -0.13 -1.4 -0.87 1.4
uniform mat2x4 expected 2.3452 -0.72199994 2.2282 1.6966001 -2.5052001 1.522 -0.4881999 -1.6766
uniform float tolerance 5.0503873e-05
draw rect ortho 4 0 4 4
uniform mat2x4 arg0 -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
uniform mat2x2 arg1 1.6 1.53 0.76 -1.0
uniform mat2x4 expected -0.4998 -2.8229 -1.8249002 2.2089 -1.5152 -1.1164 -1.6784 -0.902
uniform float tolerance 4.8580732e-05
draw rect ortho 8 0 4 4
uniform mat2x4 arg0 -1.02 -1.64 -1.59 0.3 0.74 -0.13 0.47 1.13
uniform mat2x2 arg1 -0.13 -1.4 -0.87 1.4
uniform mat2x4 expected -0.9034 0.39519998 -0.4513 -1.6209999 1.9233999 1.2448 2.0413 1.321
uniform float tolerance 3.8684066e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
