[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform ivec3 arg0;
uniform int arg1;
uniform ivec3 expected;

void main()
{
  gl_Position = gl_Vertex;
  ivec3 result = arg0;
  result /= arg1;
  color = result == expected ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform ivec3 arg0 -36 32 -88
uniform int arg1 12
uniform ivec3 expected -3 2 -7
draw rect ortho 0 0 4 4
uniform ivec3 arg0 -36 32 -88
uniform int arg1 -6
uniform ivec3 expected 6 -5 14
draw rect ortho 4 0 4 4
uniform ivec3 arg0 -36 32 -88
uniform int arg1 76
uniform ivec3 expected 0 0 -1
draw rect ortho 8 0 4 4
uniform ivec3 arg0 -36 32 -88
uniform int arg1 -32
uniform ivec3 expected 1 -1 2
draw rect ortho 12 0 4 4
uniform ivec3 arg0 36 32 88
uniform int arg1 12
uniform ivec3 expected 3 2 7
draw rect ortho 16 0 4 4
uniform ivec3 arg0 36 32 88
uniform int arg1 -6
uniform ivec3 expected -6 -5 -14
draw rect ortho 20 0 4 4
uniform ivec3 arg0 36 32 88
uniform int arg1 76
uniform ivec3 expected 0 0 1
draw rect ortho 24 0 4 4
uniform ivec3 arg0 36 32 88
uniform int arg1 -32
uniform ivec3 expected -1 -1 -2
draw rect ortho 28 0 4 4
uniform ivec3 arg0 59 77 68
uniform int arg1 12
uniform ivec3 expected 4 6 5
draw rect ortho 32 0 4 4
uniform ivec3 arg0 59 77 68
uniform int arg1 -6
uniform ivec3 expected -9 -12 -11
draw rect ortho 36 0 4 4
uniform ivec3 arg0 59 77 68
uniform int arg1 76
uniform ivec3 expected 0 1 0
draw rect ortho 40 0 4 4
uniform ivec3 arg0 59 77 68
uniform int arg1 -32
uniform ivec3 expected -1 -2 -2
draw rect ortho 44 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
