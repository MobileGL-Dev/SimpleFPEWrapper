[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform bool arg0;
uniform mat2 arg1;
uniform mat2 arg2;
uniform float tolerance;
uniform mat2 expected;

void main()
{
  gl_Position = gl_Vertex;
  mat2 result = (arg0 ? arg1 : arg2);
  mat2 residual = result - expected;
  float error_sq = residual[0][0] * residual[0][0] + residual[0][1] * residual[0][1] + residual[1][0] * residual[1][0] + residual[1][1] * residual[1][1];
  color = error_sq <= tolerance * tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform int arg0 0
uniform mat2x2 arg1 1.6 1.53 0.76 -1.0
uniform mat2x2 arg2 1.6 1.53 0.76 -1.0
uniform mat2x2 expected 1.6 1.53 0.76 -1.0
uniform float tolerance 2.5452897e-05
draw rect ortho 0 0 4 4
uniform int arg0 0
uniform mat2x2 arg1 1.6 1.53 0.76 -1.0
