[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform bool arg0;
uniform ivec2 arg1;
uniform ivec2 arg2;
uniform ivec2 expected;

void main()
{
  gl_Position = gl_Vertex;
  ivec2 result = (arg0 ? arg1 : arg2);
  color = result == expected ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform int arg0 0
uniform ivec2 arg1 38 35
uniform ivec2 arg2 38 35
uniform ivec2 expected 38 35
