[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform vec2 arg0;
uniform float arg1;
uniform float arg2;
uniform float tolerance;
uniform vec2 expected;

void main()
{
  vec2 result = clamp(arg0, arg1, arg2);
  gl_FragColor = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec2 arg0 -2.0 -0.6666667
uniform float arg1 -1.5
uniform float arg2 -1.5
uniform vec2 expected -1.5 -1.5
uniform float tolerance 2.1213204e-05
draw rect ortho 0 0 4 4
uniform vec2 arg0 0.6666667 2.0
uniform float arg1 -1.5
uniform float arg2 -1.5
uniform vec2 expected -1.5 -1.5
uniform float tolerance 2.1213204e-05
