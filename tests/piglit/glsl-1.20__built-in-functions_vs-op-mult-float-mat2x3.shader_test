uniform float arg0 0.85
uniform mat2x3 arg1 -0.46 -0.45 1.03 1.94 -0.75 -0.5
uniform mat2x3 expected -0.39100003 -0.3825 0.8755 1.649 -0.63750005 -0.425
uniform float tolerance 2.0909138e-05
