uniform float arg0 -1.33
uniform mat3x2 arg1 -0.36 -0.53 -1.08 0.88 -0.6 -1.79
uniform mat3x2 expected 3.6944444 2.5094342 1.2314814 -1.5113637 2.2166667 0.7430168
uniform float tolerance 5.404871e-05
draw rect ortho 12 0 4 4
uniform float arg0 0.85
uniform mat3x2 arg1 0.09 -1.19 1.3 0.08 1.25 1.08
uniform mat3x2 expected 9.444445 -0.7142857 0.6538462 10.625001 0.68 0.787037
