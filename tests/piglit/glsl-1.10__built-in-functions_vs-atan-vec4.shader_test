[require]
GLSL >= 1.10

[vertex shader]
varying vec4 color;
uniform vec4 arg0;
uniform float tolerance;
uniform vec4 expected;

void main()
{
  gl_Position = gl_Vertex;
  vec4 result = atan(arg0);
  color = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec4 arg0 0.0 1e-10 -1e-10 0.1
uniform vec4 expected 0.0 1e-10 -1e-10 0.09966865
uniform float tolerance 0.0002
draw rect ortho 0 0 4 4
uniform vec4 arg0 -0.1 1.0 -1.0 10.0
uniform vec4 expected -0.09966865 0.7853982 -0.7853982 1.4711276
uniform float tolerance 0.0018460545
draw rect ortho 4 0 4 4
uniform vec4 arg0 -10.0 10000000000.0 -10000000000.0 0.0
uniform vec4 expected -1.4711276 1.5707964 -1.5707964 0.0
uniform float tolerance 0.0026662743
draw rect ortho 8 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
