[require]
GLSL >= 1.20

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform mat2x3 arg0;
uniform mat2x3 arg1;

void main()
{
  if((arg0 == arg1))
    gl_FragColor = vec4(1.0, 1.0, 0.0, 1.0);
  else
    gl_FragColor = vec4(0.0, 0.0, 1.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform mat2x3 arg0 -0.46 -0.45 1.03 1.94 -0.75 -0.5
uniform mat2x3 arg1 -0.46 -0.45 1.03 1.94 -0.75 -0.5
draw rect ortho 0 0 4 4
uniform mat2x3 arg0 -0.46 -0.45 1.03 1.94 -0.75 -0.5
uniform mat2x3 arg1 1.38 -1.27 1.0 -1.08 1.83 -0.74
draw rect ortho 4 0 4 4
uniform mat2x3 arg0 1.38 -1.27 1.0 -1.08 1.83 -0.74
uniform mat2x3 arg1 -0.46 -0.45 1.03 1.94 -0.75 -0.5
draw rect ortho 8 0 4 4
uniform mat2x3 arg0 1.38 -1.27 1.0 -1.08 1.83 -0.74
uniform mat2x3 arg1 1.38 -1.27 1.0 -1.08 1.83 -0.74
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (1.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 0.0, 1.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 0.0, 1.0, 1.0)
probe rect rgba (12, 0, 4, 4) (1.0, 1.0, 0.0, 1.0)
