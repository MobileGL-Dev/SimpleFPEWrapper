[require]
GLSL >= 1.10

[vertex shader]
void main()
{
        gl_Position = gl_Vertex;
}

[fragment shader]
uniform vec2 arg0;
uniform mat2 arg1;
uniform float tolerance;
uniform vec2 expected;

void main()
{
  vec2 result = (arg0 * arg1);
  gl_FragColor = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec2 arg0 -0.1 -1.2
uniform mat2x2 arg1 1.6 1.53 0.76 -1.0
uniform vec2 expected -1.996 1.1240001
uniform float tolerance 2.2907187e-05
draw rect ortho 0 0 4 4
uniform vec2 arg0 -0.1 -1.2
uniform mat2x2 arg1 -0.13 -1.4 -0.87 1.4
uniform vec2 expected 1.6930001 -1.593
uniform float tolerance 2.3246286e-05
draw rect ortho 4 0 4 4
uniform vec2 arg0 -0.42 0.48
uniform mat2x2 arg1 1.6 1.53 0.76 -1.0
uniform vec2 expected 0.06239998 -0.7992
uniform float tolerance 8.016323e-06
draw rect ortho 8 0 4 4
uniform vec2 arg0 -0.42 0.48
uniform mat2x2 arg1 -0.13 -1.4 -0.87 1.4
uniform vec2 expected -0.6174 1.0374
uniform float tolerance 1.2072205e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
