[require]
GLSL >= 1.20

[vertex shader]
varying vec4 color;
uniform vec3 arg0;
uniform mat2x3 arg1;
uniform float tolerance;
uniform vec2 expected;

void main()
{
  gl_Position = gl_Vertex;
  vec2 result = (arg0 * arg1);
  color = distance(result, expected) <= tolerance ? vec4(0.0, 1.0, 0.0, 1.0) : vec4(1.0, 0.0, 0.0, 1.0);
}

[fragment shader]
varying vec4 color;

void main()
{
  gl_FragColor = color;
}

[test]
clear color 0.0 0.0 1.0 0.0
clear
uniform vec3 arg0 -0.03 -0.85 -0.94
uniform mat2x3 arg1 -0.46 -0.45 1.03 1.94 -0.75 -0.5
uniform vec2 expected -0.57189995 1.0493001
uniform float tolerance 1.1950314e-05
draw rect ortho 0 0 4 4
uniform vec3 arg0 -0.03 -0.85 -0.94
uniform mat2x3 arg1 1.38 -1.27 1.0 -1.08 1.83 -0.74
uniform vec2 expected 0.098100014 -0.82750005
uniform float tolerance 8.332947e-06
draw rect ortho 4 0 4 4
uniform vec3 arg0 1.67 0.66 1.87
uniform mat2x3 arg1 -0.46 -0.45 1.03 1.94 -0.75 -0.5
uniform vec2 expected 0.8608999 1.8098
uniform float tolerance 2.0041269e-05
draw rect ortho 8 0 4 4
uniform vec3 arg0 1.67 0.66 1.87
uniform mat2x3 arg1 1.38 -1.27 1.0 -1.08 1.83 -0.74
uniform vec2 expected 3.3364 -1.9796
uniform float tolerance 3.879482e-05
draw rect ortho 12 0 4 4
probe rect rgba (0, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (4, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (8, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
probe rect rgba (12, 0, 4, 4) (0.0, 1.0, 0.0, 1.0)
